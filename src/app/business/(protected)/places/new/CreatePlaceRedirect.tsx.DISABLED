"use client";

import { useEffect } from "react";
import { useRouter } from "next/navigation";

export function CreatePlaceRedirect() {
  const router = useRouter();

  useEffect(() => {
    async function findOrCreateDraft() {
      try {
        // Check for existing draft
        const checkRes = await fetch("/api/business/places/draft");
        
        if (checkRes.ok) {
          const { draft } = await checkRes.json();
          
          if (draft) {
            // Redirect to existing draft
            console.log("[CreatePlaceRedirect] Found existing draft, redirecting:", draft.id);
            router.push(`/business/places/${draft.id}/edit?step=1`);
            return;
          }
        }

        // No draft exists, create new one
        const createRes = await fetch("/api/business/places", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            title: "Новое место",
            category: "other",
            shortDesc: "Описание места",
          }),
        });

        if (!createRes.ok) {
          throw new Error("Failed to create place");
        }

        const { place } = await createRes.json();
        console.log("[CreatePlaceRedirect] Created new draft:", place.id);
        router.push(`/business/places/${place.id}/edit?step=1`);
      } catch (error) {
        console.error("[CreatePlaceRedirect] Error:", error);
        router.push("/business/places");
      }
    }

    findOrCreateDraft();
  }, [router]);

  return (
    <div className="flex items-center justify-center min-h-screen">
      <div className="text-center">
        <div className="animate-spin rounded-full h-12 w-12 border-b-2 border-primary mx-auto mb-4" />
        <p className="text-muted-foreground">Создаём место...</p>
      </div>
    </div>
  );
}
