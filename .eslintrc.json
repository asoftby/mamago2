{
  "extends": ["next/core-web-vitals", "eslint:recommended"],
  "rules": {
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "@/components/navigation/IntentTabs",
            "message": "Please use '@/components/city/IntentTabs' instead."
          },
          {
            "name": "@/components/discovery/IntentTabs",
            "message": "Please use '@/components/city/IntentTabs' instead."
          },
          {
            "name": "@/components/filters/FilterControl",
            "message": "Please use '@/features/filters' (canonical) instead."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/components/activity/**/*.{ts,tsx}",
        "src/components/city/**/*.{ts,tsx}",
        "src/app/**/*.{ts,tsx}"
      ],
      "rules": {
        "max-len": ["warn", { "code": 140 }],
        "@typescript-eslint/no-explicit-any": "warn"
      }
    }
  ]
}
