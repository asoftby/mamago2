# ~mamago-exec/.ssh/authorized_keys — one key per environment, each locked to it.
restrict,from="127.0.0.1",command="/opt/mamago-deploy/gate --env dev" ssh-ed25519 AAAA...DEV mamago-bot@legacy-dev
restrict,from="127.0.0.1",command="/opt/mamago-deploy/gate --env prod" ssh-ed25519 AAAA...PROD mamago-bot@legacy-prod
