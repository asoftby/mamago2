# SMS.by Configuration
SMS_BY_BASE_URL=https://app.sms.by
SMS_BY_TOKEN=your_sms_by_token_here
SMS_BY_SENDER=mamaGo.by
# Set to "true" in development to actually send SMS (instead of just logging the code)
FORCE_SMS=false

# OTP Secret (generate a long random string)
OTP_SECRET=your_otp_secret_here

# Hero weather: omit or `mock` for MockWeatherProvider; `open-meteo` for Open-Meteo (no API key)
# WEATHER_PROVIDER=open-meteo

# Application URL (публичный URL для ссылок в письмах; может дублировать NEXT_PUBLIC_APP_URL)
APP_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Публичные соцсети (футер) — опционально переопределяют дефолты из src/lib/site/publicSocialLinks.ts
# NEXT_PUBLIC_SOCIAL_INSTAGRAM_URL=https://www.instagram.com/...
# NEXT_PUBLIC_SOCIAL_TIKTOK_URL=https://www.tiktok.com/@...
# NEXT_PUBLIC_SOCIAL_TELEGRAM_URL=https://t.me/...
# Telegram без этой строки: NEXT_PUBLIC_TELEGRAM_BOT_USERNAME / NEXT_PUBLIC_TELEGRAM_BOT_URL или fallback t.me/mamago_2_bot

# Google Maps API Key (required)
# Get your API key from: https://console.cloud.google.com/google/maps-apis
# Required APIs: Maps JavaScript API, Places API, Geocoding API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google Map ID (optional, for Vector maps and AdvancedMarkerElement)
# Create a Map ID in Google Cloud Console: https://console.cloud.google.com/google/maps-apis/studio/maps
# Recommended: Create a Vector map without Tilt/Rotation for better performance
# If not provided, the app will use regular Marker instead of AdvancedMarkerElement
NEXT_PUBLIC_GOOGLE_MAP_ID=your_map_id_here

# Transactional email (Resend) — см. src/features/email/server/email-service.tsx
# RESEND_API_KEY=re_...
# EMAIL_FROM="mamaGo <no-reply@send.mamago.by>"
# EMAIL_REPLY_TO=hello@mamago.by
# EMAIL_ENABLED=true
# EMAIL_DEBUG_REDIRECT_TO=...   # опционально: все письма пересылать на этот адрес
#
# Устаревший stub для in-app уведомлений (emailAdapter): см. src/lib/email/emailAdapter.ts
EMAIL_FROM=noreply@example.com
