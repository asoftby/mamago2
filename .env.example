# SMS.by Configuration
SMS_BY_BASE_URL=https://app.sms.by
SMS_BY_TOKEN=your_sms_by_token_here
SMS_BY_SENDER=mamaGo.by
# Set to "true" in development to actually send SMS (instead of just logging the code)
FORCE_SMS=false

# OTP Secret (generate a long random string)
OTP_SECRET=your_otp_secret_here

# Cron job authorization secret — required in production; all /api/cron/* routes reject without it
# Generate: openssl rand -base64 32
CRON_SECRET=

# Hero weather: Open-Meteo provider (no API key)
# WEATHER_PROVIDER=open-meteo

# Application URL (публичный URL для ссылок в письмах; может дублировать NEXT_PUBLIC_APP_URL)
APP_PUBLIC_URL=http://mamago.local:3000
NEXT_PUBLIC_APP_URL=http://mamago.local:3000

# Build / runtime diagnostics
APP_ENV=staging

# Phoenix deployment identity gates. Set these through the deployment secret
# store; all three must match --environment exactly.
PHOENIX_DATABASE_ENV=DEV
PHOENIX_STORAGE_ENV=DEV
PHOENIX_STORAGE_PROVIDER=filesystem
PHOENIX_STORAGE_LOCATION=storage/uploads
# Optional, usually provided by deploy platform:
# GIT_BRANCH=dev
# GIT_COMMIT_SHA=
# BUILD_TIME=
# BUILD_ID= (immutable image/build tag, e.g. dev-310 — baked in at Docker build time, see .github/workflows/docker.yml)

# Auth session cookie (mg_session) environment scoping.
# `next start` always sets NODE_ENV=production, even for local/DEV builds, so
# APP_ENV — not NODE_ENV — decides whether the cookie gets Domain=.mamago.by;
# Secure=true. Only APP_ENV=production/prod scopes the cookie to production.
# LOCAL builds get a host-only cookie and Secure=false over HTTP, except
# mamago.local, which shares across its admin/business subdomains.
# Required HTTPS preview overrides (take precedence over APP_ENV):
# DEV preview:        AUTH_COOKIE_DOMAIN=.dev.mamago.by
# First-PROD preview: AUTH_COOKIE_DOMAIN=.prod.mamago.by
# Both previews:      AUTH_COOKIE_SECURE=true
# Future real cutover only: AUTH_COOKIE_DOMAIN=.mamago.by with APP_ENV=production

# SEO / indexation safety flags
# Use APP_ENV to distinguish staging/preview/prod explicitly; do not rely on NODE_ENV alone.
# Production launch is fail-closed: indexing opens ONLY with SITE_INDEXING_ENABLED=true.
# SITE_NOINDEX_DEFAULT=false alone does NOT open indexing.
# Staging/dev/preprod: keep SITE_INDEXING_ENABLED=false (or unset).
SITE_INDEXING_ENABLED=false
SITE_NOINDEX_DEFAULT=false
# Emergency override with highest priority. true always closes indexing, even when SITE_INDEXING_ENABLED=true.
SITE_NOINDEX_FORCE=false

# Telegram webhook (canonical path: /api/bot/webhook)
# Bot credentials are selected by APP_ENV, not NODE_ENV:
#   APP_ENV=local|dev|staging|preview -> TELEGRAM_*_DEV
#   APP_ENV=production|prod           -> TELEGRAM_*_PROD
# Local laptop:
# 1. Run the app at http://mamago.local:3000
# 2. Tunnel origin must target localhost:3000:
#    cloudflared tunnel --url http://localhost:3000
# 3. Register webhook with secret_token (required on deployed hosts):
#    export TELEGRAM_BOT_TOKEN="$(grep TELEGRAM_BOT_TOKEN_DEV .env.local | cut -d= -f2)"
#    export WEBHOOK_SECRET="$(grep TELEGRAM_WEBHOOK_SECRET_DEV .env.local | cut -d= -f2)"
#    curl -X POST "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/setWebhook" \
#      -H "Content-Type: application/json" \
#      -d '{"url":"https://YOUR_TUNNEL.trycloudflare.com/api/bot/webhook","secret_token":"YOUR_WEBHOOK_SECRET"}'
# Deployed DEV: https://dev.mamago.by/api/bot/webhook
# Deployed PROD: https://prod.mamago.by/api/bot/webhook
# Details: docs/TELEGRAM_WEBHOOK_DEV_SETUP.md
#
# ВАЖНО: TELEGRAM_BOT_TOKEN_DEV — токен от BotFather для dev-бота (не коммитьте реальные значения).

# Публичные соцсети (футер) — опционально переопределяют дефолты из src/lib/site/publicSocialLinks.ts
# NEXT_PUBLIC_SOCIAL_INSTAGRAM_URL=https://www.instagram.com/...
# NEXT_PUBLIC_SOCIAL_TIKTOK_URL=https://www.tiktok.com/@...
# NEXT_PUBLIC_SOCIAL_TELEGRAM_URL=https://t.me/...
# Telegram bot credentials (server-side, env-aware)
# Development / localhost / staging use DEV bot
TELEGRAM_BOT_TOKEN_DEV=replace_me
TELEGRAM_BOT_USERNAME_DEV=@your_dev_bot
# Webhook secret for DEV bot (required on deployed DEV; optional only for local next dev).
# Generate: openssl rand -hex 32
# Pass the same value to setWebhook as secret_token.
TELEGRAM_WEBHOOK_SECRET_DEV=
# Production uses separate PROD bot
TELEGRAM_BOT_TOKEN_PROD=
TELEGRAM_BOT_USERNAME_PROD=
# Webhook secret for PROD bot (required in production)
TELEGRAM_WEBHOOK_SECRET_PROD=

# Legacy public fallback for static UI links (optional)
# NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# NEXT_PUBLIC_TELEGRAM_BOT_URL=

# Google Maps API Key (required)
# Get your API key from: https://console.cloud.google.com/google/maps-apis
# Required APIs: Maps JavaScript API, Places API, Geocoding API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google Map ID (optional, for Vector maps and AdvancedMarkerElement)
# Create a Map ID in Google Cloud Console: https://console.cloud.google.com/google-maps-apis/studio/maps
# Recommended: Create a Vector map without Tilt/Rotation for better performance
# If not provided, the app will use regular Marker instead of AdvancedMarkerElement
NEXT_PUBLIC_GOOGLE_MAP_ID=your_map_id_here

# Transactional email (Resend) — single canonical pipeline:
# src/features/email/server/email-service.tsx
EMAIL_ENABLED=false
RESEND_API_KEY=re_...
EMAIL_FROM="mamaGo <no-reply@mamago.by>"
EMAIL_REPLY_TO=hello@mamago.by
# DEV only: redirect every outbound email to a controlled inbox.
# PROD must leave this empty so real users receive mail.
# EMAIL_DEBUG_REDIRECT_TO=owner-test@example.com
# Migrated-user activation email delivery — see src/server/auth/activationEmailGate.ts
# (resolveActivationEmailDelivery) and src/server/auth/activationEmailDelivery.ts
# (deliverMigratedAccountActivationEmail, the Resend-backed provider adapter).
# Disabled unless ALL of these agree: NODE_ENV=production, APP_ENV=production,
# MIGRATED_USER_ACTIVATION_EMAIL_ENABLED=true, MIGRATED_USER_ACTIVATION_EMAIL_PRODUCTION_APPROVED=true.
# Flipping either flag back to false is the kill switch — takes effect on the next request, nothing to restart.
# LOCAL/DEV are hard-disabled regardless of these two flags (NODE_ENV/APP_ENV never equal "production" there).
# MIGRATED_USER_ACTIVATION_EMAIL_ENABLED=false
# MIGRATED_USER_ACTIVATION_EMAIL_PRODUCTION_APPROVED=false
# Activation links are built from APP_PUBLIC_URL / NEXT_PUBLIC_APP_URL + /activate?token=...;
# delivery is skipped (not sent to a wrong host) if neither public URL is set.
# Trust forwarding headers only when the deployment proxy strips client-supplied values.
# TRUST_PROXY_HEADERS=false

# Уведомления администраторам о заявках на верификацию бизнеса идут через
# общий notification-слой (in-app + Telegram по TELEGRAM_BOT_TOKEN_DEV/PROD):
# см. notifyAdminsBusinessApplicationCreated в src/server/services/notification.service.ts.
# Отдельные переменные (TELEGRAM_ADMIN_*, ADMIN_NOTIFY_WEBHOOK_URL,
# ADMIN_NOTIFICATION_EMAIL) больше не используются.

# OpenRouter AI (rewrite descriptions)
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_TEMPERATURE=0.4
OPENROUTER_MAX_TOKENS=900
OPENROUTER_SITE_URL=http://mamago.local:3000
OPENROUTER_APP_NAME=mamaGo 2.0

# Feature gates — set to "true" only when the backend is production-ready
# Billing module: hides /business/billing from nav and redirects direct URL access
NEXT_PUBLIC_BILLING_ENABLED=false

# First-PROD owner-approved Boost catalogue. Missing/invalid values disable purchase.
# Prices are server-authoritative BYN values with at most two decimal places.
BOOST_PRICE_1D_BYN=5
BOOST_PRICE_3D_BYN=12
BOOST_PRICE_7D_BYN=25

# Debug flags
# Set to "true" to enable debug logging for PublicLayoutBody mount/unmount
# NEXT_PUBLIC_PUBLIC_LAYOUT_DEBUG=true

# Third-party public analytics (Google Analytics 4, Yandex Metrica).
# Runtime server env; do not use NEXT_PUBLIC_*.
# Loaded only on public pages after analytics consent.
# Fail-closed unless APP_ENV=production|prod and flag=true.
EXTERNAL_ANALYTICS_ENABLED=false
GOOGLE_ANALYTICS_ID=
YANDEX_METRIKA_ID=
