# SMS.by Configuration
SMS_BY_BASE_URL=https://app.sms.by
SMS_BY_TOKEN=your_sms_by_token_here
SMS_BY_SENDER=mamaGo.by
# Set to "true" in development to actually send SMS (instead of just logging the code)
FORCE_SMS=false

# OTP Secret (generate a long random string)
OTP_SECRET=your_otp_secret_here

# Hero weather: Open-Meteo provider (no API key)
# WEATHER_PROVIDER=open-meteo

# Application URL (публичный URL для ссылок в письмах; может дублировать NEXT_PUBLIC_APP_URL)
APP_PUBLIC_URL=http://mamago.local:3000
NEXT_PUBLIC_APP_URL=http://mamago.local:3000

# Telegram webhook dev setup:
# 1. Локально приложение открывай через http://mamago.local:3000
# 2. Для webhook туннеля используй origin localhost:3000:
#    cloudflared tunnel --url http://localhost:3000
# 3. Установи webhook (подставь реальный URL туннеля):
#    export TELEGRAM_BOT_TOKEN="$(grep TELEGRAM_BOT_TOKEN_DEV .env.local | cut -d= -f2)"
#    curl -X POST "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/setWebhook" \
#      -d '{"url":"https://YOUR_TUNNEL.trycloudflare.com/api/telegram/webhook"}'
# Подробнее: docs/TELEGRAM_WEBHOOK_DEV_SETUP.md
#
# ВАЖНО: TELEGRAM_BOT_TOKEN_DEV — реальный токен от BotFather, не плейсхолдер!

# Публичные соцсети (футер) — опционально переопределяют дефолты из src/lib/site/publicSocialLinks.ts
# NEXT_PUBLIC_SOCIAL_INSTAGRAM_URL=https://www.instagram.com/...
# NEXT_PUBLIC_SOCIAL_TIKTOK_URL=https://www.tiktok.com/@...
# NEXT_PUBLIC_SOCIAL_TELEGRAM_URL=https://t.me/...
# Telegram bot credentials (server-side, env-aware)
# Development / localhost / staging use DEV bot
TELEGRAM_BOT_TOKEN_DEV=8629245853:AAFFta2WLJML5Q1JOELWED7QAOaP-ias0NI
TELEGRAM_BOT_USERNAME_DEV=@mamago_dev_bot
# Webhook secret for DEV bot (optional but recommended).
# Generate: openssl rand -hex 32
# Pass the same value to setWebhook as secret_token.
TELEGRAM_WEBHOOK_SECRET_DEV=
# Production uses separate PROD bot
TELEGRAM_BOT_TOKEN_PROD=
TELEGRAM_BOT_USERNAME_PROD=
# Webhook secret for PROD bot (required in production)
TELEGRAM_WEBHOOK_SECRET_PROD=

# Legacy public fallback for static UI links (optional)
# NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# NEXT_PUBLIC_TELEGRAM_BOT_URL=

# Google Maps API Key (required)
# Get your API key from: https://console.cloud.google.com/google/maps-apis
# Required APIs: Maps JavaScript API, Places API, Geocoding API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google Map ID (optional, for Vector maps and AdvancedMarkerElement)
# Create a Map ID in Google Cloud Console: https://console.cloud.google.com/google/maps-apis/studio/maps
# Recommended: Create a Vector map without Tilt/Rotation for better performance
# If not provided, the app will use regular Marker instead of AdvancedMarkerElement
NEXT_PUBLIC_GOOGLE_MAP_ID=your_map_id_here

# Transactional email (Resend) — см. src/features/email/server/email-service.tsx
# RESEND_API_KEY=re_...
# EMAIL_FROM="mamaGo <no-reply@send.mamago.by>"
# EMAIL_REPLY_TO=hello@mamago.by
# EMAIL_ENABLED=true
# EMAIL_DEBUG_REDIRECT_TO=...   # опционально: все письма пересылать на этот адрес
#
# Устаревший stub для in-app уведомлений (emailAdapter): см. src/lib/email/emailAdapter.ts
EMAIL_FROM=noreply@example.com

# OpenRouter AI (rewrite descriptions)
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_TEMPERATURE=0.4
OPENROUTER_MAX_TOKENS=900
OPENROUTER_SITE_URL=http://mamago.local:3000
OPENROUTER_APP_NAME=mamaGo 2.0

# Debug flags
# Set to "true" to enable debug logging for PublicLayoutBody mount/unmount
# NEXT_PUBLIC_PUBLIC_LAYOUT_DEBUG=true
