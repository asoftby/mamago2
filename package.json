{
  "name": "mamago2",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": "22.x"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@<1.1.13": ">=1.1.13",
      "fast-uri@<=3.1.1": "3.1.2",
      "brace-expansion@>=5.0.0 <5.0.6": "5.0.6",
      "ws@>=8.0.0 <8.21.0": "8.21.0",
      "hono@<4.12.25": "4.12.25",
      "js-yaml@<=4.1.1": "4.2.0",
      "markdown-it@<=14.1.1": "14.2.0",
      "@opentelemetry/core@<2.8.0": "2.8.0",
      "@babel/core@<=7.29.0": "7.29.6",
      "qs@<6.15.2": "6.15.2",
      "ip-address@<=10.1.0": "10.1.1",
      "esbuild@<0.28.1": "0.28.1",
      "@react-email/preview-server>next": "16.2.9",
      "postcss": "8.5.10",
      "effect": "3.20.0"
    }
  },
  "scripts": {
    "dev": "ulimit -n 65536 && next dev --webpack -H 0.0.0.0",
    "dev:turbo": "ulimit -n 65536 && next dev --turbo -H 0.0.0.0",
    "dev:webpack": "next dev",
    "email:preview": "react-email dev --dir ./emails --port 3011",
    "build": "NODE_OPTIONS=--max-old-space-size=6144 next build --webpack",
    "build:ci": "NODE_OPTIONS=--max-old-space-size=4096 next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "check": "tsc --noEmit && eslint src --quiet && pnpm build",
    "postinstall": "prisma generate",
    "db:preflight": "node scripts/db-preflight.mjs",
    "db:generate": "/bin/zsh -lc 'set -a; source .env >/dev/null 2>&1; set +a; prisma generate --schema prisma/schema.prisma'",
    "db:validate": "/bin/zsh -lc 'set -a; source .env >/dev/null 2>&1; set +a; prisma validate --schema prisma/schema.prisma'",
    "db:migrate": "prisma migrate dev",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:status": "pnpm db:preflight && /bin/zsh -lc 'set -a; source .env >/dev/null 2>&1; set +a; prisma migrate status --schema prisma/schema.prisma'",
    "db:migrate:deploy": "pnpm db:preflight && /bin/zsh -lc 'set -a; source .env >/dev/null 2>&1; set +a; prisma migrate deploy --schema prisma/schema.prisma'",
    "db:seed": "prisma db seed",
    "db:seed:system": "prisma db seed",
    "db:seed:demo": "tsx scripts/dev/seed-demo-data.ts",
    "db:reset:dev": "prisma migrate reset",
    "ui:audit": "node scripts/ui-usage-audit.mjs",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts",
    "cleanup:otp": "tsx scripts/db/cleanup-phone-otps.ts",
    "backfill:verification": "tsx prisma/scripts/backfillVerificationStatus.ts",
    "db:backfill:business-members": "tsx prisma/scripts/backfill-business-members.ts",
    "backfill:place-slugs": "tsx scripts/data-migrations/backfill-place-slugs.ts",
    "import:preview": "tsx scripts/import-preview.ts",
    "migration:commit:wordpress-db": "tsx scripts/migration-commit-wordpress-db.ts",
    "migration:user": "tsx scripts/migration-user-vertical-slice.ts",
    "migration:user:batch": "tsx scripts/migration-user-clean-batch.ts",
    "migration:users:plan-ownership": "tsx scripts/migration-user-plan-ownership.ts",
    "migration:users:business-ownership-golden": "tsx scripts/migration-business-ownership-golden.ts",
    "migration:commit:wordpress-db-from-json": "tsx scripts/migration-commit-wordpress-db-from-json.ts",
    "migration:inspect:wordpress-db": "tsx scripts/migration-inspect-wordpress-db.ts",
    "migration:preview:wordpress-db": "tsx scripts/migration-preview-wordpress-db.ts",
    "migration:preview:offer-snapshot": "tsx scripts/migration-preview-offer-snapshot.ts",
    "migration:preview:offer-remediation": "tsx scripts/migration-preview-offer-remediation.ts",
    "migration:route-review": "tsx scripts/migration-route-review.ts",
    "migration:apply-route-review": "tsx scripts/migration-apply-route-review.ts",
    "notifications:plan-reminders": "tsx src/server/notifications/jobs/run-plan-event-reminders.ts",
    "notifications:plan-tomorrow-digests": "tsx src/server/notifications/jobs/run-plan-tomorrow-digests.ts",
    "db:backup": "bash scripts/backup-local-db.sh",
    "db:backup:sql": "bash scripts/db/backup-sql.sh",
    "db:backups": "bash scripts/db/list-backups.sh",
    "db:restore": "bash scripts/db/restore.sh",
    "db:backup:pre": "bash scripts/db/backup.sh",
    "db:reset:safe": "pnpm db:backup && pnpm prisma migrate reset --force",
    "db:migrate:safe": "pnpm db:backup && pnpm prisma migrate dev",
    "build-migration-manifest": "tsx scripts/build-migration-manifest.ts",
    "test:unit": "tsx src/lib/slugifyLabelToValue.test.ts",
    "test:notifications-mvp": "tsx src/lib/notifications/userNotificationPresentation.test.ts && tsx src/server/notifications/notification-renderer.test.ts && tsx src/server/notifications/notification-dedupe.test.ts && tsx src/server/notifications/notification.service.test.ts && tsx src/server/notifications/jobs/run-plan-event-reminders.test.ts && tsx src/server/notifications/template-render.test.ts",
    "test:notification-templates": "tsx src/server/notifications/template-render.test.ts",
    "test:anti-repeat": "tsx src/features/hero-weather/model/anti-repeat.test.ts",
    "test:weather-provider": "tsx src/features/hero-weather/api/weather-provider.test.ts",
    "test:unp-verification": "tsx src/lib/verification/unpChecksum.test.ts && tsx src/lib/verification/companyNameMatch.test.ts && tsx src/server/egr/verifyUnp.test.ts",
    "test:redirect-manifest": "tsx src/lib/seo/redirectManifest.test.ts",
    "test:wp-catch-all": "tsx src/lib/routing/wpLegacyCatchAll.test.ts",
    "test:rate-limit": "tsx src/lib/security/rateLimit.test.ts",
    "test:offer-published-edit-gate": "tsx src/lib/offers/offerPublishedEditGate.test.ts",
    "test:branding-media-asset-usage": "NODE_OPTIONS=--conditions=react-server tsx src/server/media/brandingMediaAssetUsage.test.ts",
    "test:article-media-replay": "tsx src/lib/migration/runtime/articleMediaOnlyReplay.test.ts && tsx src/lib/migration/runtime/strictArticleMediaReplay.test.ts",
    "search:reindex": "tsx scripts/search-reindex.ts",
    "prepare": "husky",
    "check:push": "pnpm build",
    "check:no-old-social-links": "sh -c 'OLD_URL=$(printf \"%s%s\" \"https://www.tiktok.com/\" \"@mamago.by\"); if git grep -n \"$OLD_URL\" -- src prisma public .env.example; then echo \"Old TikTok URL found in tracked source/example files\"; exit 1; fi'"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@googlemaps/js-api-loader": "^2.0.2",
    "@hookform/resolvers": "^5.2.2",
    "@meteocons/svg": "^0.1.0",
    "@prisma/client": "6.19.2",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@react-email/components": "^1.0.11",
    "@react-email/render": "^2.0.5",
    "@sentry/nextjs": "^10.52.0",
    "@tiptap/core": "^3.20.1",
    "@tiptap/extension-link": "^3.20.1",
    "@tiptap/extension-placeholder": "^3.20.1",
    "@tiptap/extension-underline": "^3.20.1",
    "@tiptap/react": "^3.20.1",
    "@tiptap/starter-kit": "^3.20.1",
    "bcryptjs": "^3.0.3",
    "blurhash": "^2.0.5",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "framer-motion": "^12.34.3",
    "grammy": "^1.42.0",
    "heic-to": "^1.5.2",
    "libphonenumber-js": "^1.12.40",
    "lucide-react": "^0.575.0",
    "next": "16.2.9",
    "next-themes": "^0.4.6",
    "prisma": "6.19.2",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-email": "^5.2.10",
    "react-hook-form": "^7.71.2",
    "react-phone-number-input": "^3.4.16",
    "react-responsive": "^10.0.1",
    "resend": "^6.12.4",
    "server-only": "^0.0.1",
    "sharp": "^0.33.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "vanilla-cookieconsent": "^3.0.1",
    "vaul": "^1.1.2",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.2",
    "@commitlint/config-conventional": "^20.5.0",
    "@prisma/config": "6.19.2",
    "@react-email/preview-server": "5.2.10",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/bcryptjs": "^3.0.0",
    "@types/google.maps": "^3.58.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "husky": "^9.1.7",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
