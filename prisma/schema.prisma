// Prisma ORM 7 schema (no datasource url here)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  BUSINESS_OWNER
  MODERATOR
  ADMIN
}

model Healthcheck {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
}

// Authentication models
model User {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
  role         Role   @default(USER)

  resetToken        String?
  resetTokenExpires DateTime?

  phoneE164       String?   @unique
  phoneVerifiedAt DateTime?

  sessions                     Session[]
  business                     Business? // One business per owner (MVP)
  children                     Child[]
  ideas                        Idea[]
  planItems                    PlanItem[]
  phoneOtps                    PhoneOtp[]
  reviewedBusinessVerifications BusinessVerificationLog[] @relation("ReviewedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([resetToken])
  @@index([phoneE164])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
}

model PhoneOtp {
  id         String   @id @default(cuid())
  userId     String
  phoneE164  String
  purpose    String
  codeHash   String
  expiresAt  DateTime
  lastSentAt DateTime
  attempts   Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, phoneE164, purpose])
  @@index([userId, purpose])
  @@index([phoneE164, purpose])
}

model Child {
  id        String   @id @default(cuid())
  name      String
  birthDate DateTime
  interests String?
  parentId  String

  parent User @relation(fields: [parentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
}

// User saved ideas (activities they want to remember)
model Idea {
  id         String @id @default(cuid())
  userId     String
  activityId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, activityId])
  @@index([userId])
}

// User plan items (activities scheduled for specific dates)
model PlanItem {
  id         String    @id @default(cuid())
  userId     String
  activityId String?
  date       String // YYYY-MM-DD format
  startsAt   DateTime? // Optional specific time

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity Activity? @relation(fields: [activityId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId, date])
  @@index([userId])
  @@index([activityId])
}

enum UiPlacement {
  PRIMARY
  SECONDARY
  HIDDEN
}

model SignalDefinition {
  id       String         @id @default(cuid())
  slug     String         @unique
  title    String
  order    Int            @default(0)
  isActive Boolean        @default(true)
  options  SignalOption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SignalOption {
  id           String  @id @default(cuid())
  definitionId String
  label        String
  value        String
  order        Int     @default(0)
  isActive     Boolean @default(true)

  definition SignalDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([definitionId, value])
  @@index([definitionId, isActive, order])
}

model FilterDefinition {
  id         String         @id @default(cuid())
  slug       String         @unique
  title      String
  type       String // single | multi
  ui         String // tabs | dropdown | multi_tabs
  order      Int            @default(0) // Legacy, can be removed or mapped to orderIndex
  orderIndex Int            @default(0)
  placement  UiPlacement    @default(PRIMARY)
  isActive   Boolean        @default(true)
  options    FilterOption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FilterOption {
  id         String  @id @default(cuid())
  filterId   String
  label      String
  value      String
  order      Int     @default(0) // Legacy
  orderIndex Int     @default(0)
  isActive   Boolean @default(true)

  filter                FilterDefinition       @relation(fields: [filterId], references: [id], onDelete: Cascade)
  activityFilterOptions ActivityFilterOption[]

  @@unique([filterId, value])
  @@index([filterId, isActive, order])
}

model City {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  lat       Float?
  lng       Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  districts     District[]
  metroStations MetroStation[]
  places        Place[]        @relation("PlaceCity") // Business Cabinet relation

  @@index([slug])
}

model District {
  id        String   @id @default(cuid())
  cityId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  city   City    @relation(fields: [cityId], references: [id], onDelete: Cascade)
  places Place[] @relation("PlaceDistrict") // Business Cabinet relation

  @@unique([cityId, name])
  @@index([cityId])
}

model MetroStation {
  id     String @id @default(cuid())
  cityId String
  name   String
  lat    Float
  lng    Float

  osmType String
  osmId   String
  source  String @default("OSM")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  city       City       @relation(fields: [cityId], references: [id], onDelete: Cascade)
  activities Activity[]
  places     Place[]    @relation("PlaceMetro") // Business Cabinet relation

  @@unique([cityId, osmType, osmId])
  @@unique([cityId, name])
  @@index([cityId])
}

model Activity {
  id             String  @id @default(cuid())
  name           String
  description    String?
  cityId         String?
  metroStationId String?

  // Business ownership (optional - can be created by business or admin)
  businessId String?
  createdBy  String? // userId who created it

  // Display fields
  coverImageUrl String?
  priceFrom     Float?
  currency      String? @default("BYN")
  ageLabel      String? // e.g., "6+", "3-7 лет"

  // Age range in months (for filtering)
  ageMinMonths Int?
  ageMaxMonths Int?

  metroStation  MetroStation?          @relation(fields: [metroStationId], references: [id])
  filterOptions ActivityFilterOption[]
  sessions      ActivitySession[]
  planItems     PlanItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ageMinMonths, ageMaxMonths])
  @@index([businessId])
  @@index([cityId])
}

// Activity sessions (specific dates/times when activity happens)
model ActivitySession {
  id         String   @id @default(cuid())
  activityId String
  startsAt   DateTime

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([activityId])
  @@index([startsAt])
}

model ActivityFilterOption {
  id             String @id @default(cuid())
  activityId     String
  filterOptionId String

  activity     Activity     @relation(fields: [activityId], references: [id], onDelete: Cascade)
  filterOption FilterOption @relation(fields: [filterOptionId], references: [id], onDelete: Cascade)

  @@unique([activityId, filterOptionId])
  @@index([filterOptionId])
}

// ============================================
// BUSINESS CABINET MODELS
// ============================================

// Enums for Business Cabinet
enum OfferKind {
  EVENT
  SERVICE
}

enum OfferStatus {
  DRAFT
  PENDING
  PUBLISHED
  REJECTED
}

enum BusinessStatus {
  DRAFT
  PENDING_VERIFICATION
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum BusinessVerificationStatus {
  DRAFT
  PENDING
  NEEDS_INFO
  APPROVED
  REJECTED
}

// Business entity
model Business {
  id          String         @id @default(cuid())
  name        String
  ownerUserId String         @unique // One business per owner (MVP)
  
  // Onboarding fields
  unp         String?
  legalName   String?
  phone       String?
  status      BusinessStatus @default(DRAFT)

  // Verification fields
  verificationStatus BusinessVerificationStatus @default(DRAFT)
  submittedAt        DateTime?
  reviewedAt         DateTime?
  reviewedByUserId   String?
  reviewNote         String?
  approvedAt         DateTime?
  rejectedAt         DateTime?
  isVerified         Boolean                    @default(false)

  owner            User                        @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  places           Place[]
  verificationLogs BusinessVerificationLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerUserId])
  @@index([status])
  @@index([verificationStatus])
}

// Business verification audit log
model BusinessVerificationLog {
  id               String                        @id @default(cuid())
  businessId       String
  statusFrom       BusinessVerificationStatus
  statusTo         BusinessVerificationStatus
  note             String?
  reviewedByUserId String?

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  reviewedBy User?    @relation(fields: [reviewedByUserId], references: [id], onDelete: SetNull, name: "ReviewedBy")

  createdAt DateTime @default(now())

  @@index([businessId, createdAt])
}

// Place entity
model Place {
  id         String  @id @default(cuid())
  businessId String
  title      String
  address    String
  cityId     String
  lat        Float?
  lng        Float?
  metroId    String?
  districtId String?
  phone      String?
  website    String?
  coverImage String?

  // Age range in months (for filtering)
  ageMinMonths Int?
  ageMaxMonths Int?

  business Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Foreign keys only - do NOT add reverse relations to City/MetroStation/District models
  city     City          @relation(fields: [cityId], references: [id], name: "PlaceCity")
  metro    MetroStation? @relation(fields: [metroId], references: [id], name: "PlaceMetro")
  district District?     @relation(fields: [districtId], references: [id], name: "PlaceDistrict")
  offers   Offer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@index([cityId])
  @@index([ageMinMonths, ageMaxMonths])
}

// Offer entity (EVENT or SERVICE)
model Offer {
  id          String    @id @default(cuid())
  placeId     String
  kind        OfferKind
  title       String
  description String?
  coverImage  String?
  priceFrom   Float?
  priceText   String?

  // Age range in months (easier filtering + indexing than string array)
  ageMinMonths Int?
  ageMaxMonths Int?

  // Date fields (required for EVENT, must be null for SERVICE)
  // Validation enforced at application level
  dateFrom DateTime?
  dateTo   DateTime?

  // Promo attributes (NOT separate entity)
  promoTitle       String?
  promoDescription String?
  promoUntil       DateTime?

  // Status workflow
  status          OfferStatus @default(DRAFT)
  publishedAt     DateTime?
  rejectionReason String?

  place  Place   @relation(fields: [placeId], references: [id], onDelete: Cascade)
  boosts Boost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([placeId])
  @@index([status])
  @@index([kind])
  @@index([dateFrom])
  @@index([ageMinMonths, ageMaxMonths])
}

// Boost entity (ranking modifier only)
model Boost {
  id      String   @id @default(cuid())
  offerId String
  startAt DateTime
  endAt   DateTime

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([offerId])
  @@index([startAt, endAt])
}
