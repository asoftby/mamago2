  countryCode                  String?
  customAddress                String?
  description                  String?
  formattedAddr                String?
  googlePlaceId                String?
  instagramHandle              String?
  instagramUrl                 String?
  locationSource               LocationSource     @default(MANUAL)
  logoImageId                  String?
  shortDesc                    String
  status                       ContentStatus      @default(DRAFT)
  visitFormats                 String[]
  floor                        String?
  parentPlaceId                String?
  placeKind                    PlaceKind          @default(STANDALONE)
  unit                         String?
  unitLabel                    String?
  districtAutoId               String?
  districtManualId             String?
  metroAutoId                  String?
  metroManualId                String?
  metroAutoDistanceM           Int?
  metroManualDistanceM         Int?
  createRequestId              String?
  moderatedByUserId            String?
  moderationReviewedAt         DateTime?
  moderatorComment             String?
  revisionRequestedAt          DateTime?
  revisionResubmittedAt        DateTime?
  archivedAt                   DateTime?
  archivedByUserId             String?
  hasActiveImprovementRequests Boolean            @default(false)
  slug                         String?            @unique
  shortAddress                 String?
  slugUpdatedAt                DateTime?
  placeGroupId                 String?
  openingHoursId               String?
  seoCanonicalUrl              String?
  seoDescription               String?
  seoH1                        String?
  seoJsonLdOverride            Json?
  seoOgDescription             String?
  seoOgImage                   String?
  seoOgTitle                   String?
  seoRobots                    String?
  seoTitle                     String?
  seoCanonicalSource           SeoCanonicalSource @default(FALLBACK)
  createdByUserId              String
  ownerBusinessId              String?
  /// Основная категория места (EventCategory с publicationType=PLACE, parentId=null)
  primaryCategoryId            String?
  /// Сигналы DISCOVERY домена (entityType=PLACE), ID SignalDefinition
  discoverySignalIds           String[]           @default([])

  // Настройки записи
  bookingEnabled Boolean @default(false)
  bookingPhone   String?
  bookingNote    String?

  // Google Places данные
  googleRating            Float?
  googleUserRatingsTotal  Int?
  googleReviewsJson       Json?
  googleReviewsSyncedAt   DateTime?
  googleMapsUri           String?

  priceItems              Json?

  activities      Activity[]          @relation("PlaceActivities")
  bookingRequests BookingRequest[]
  eventVenues     EventVenue[]
  importedRecords ImportedRecord[]    @relation("ImportedRecordPlace")
  offers          Offer[]
  archivedBy      User?               @relation("PlaceArchiver", fields: [archivedByUserId], references: [id])
  city            City?               @relation("PlaceCity", fields: [cityId], references: [id])
  createdBy       User                @relation("PlaceCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  districtAuto    District?           @relation("PlaceDistrictAuto", fields: [districtAutoId], references: [id])
  districtManual  District?           @relation("PlaceDistrictManual", fields: [districtManualId], references: [id])
  metroAuto       MetroStation?       @relation("PlaceMetroAuto", fields: [metroAutoId], references: [id])
  metroManual     MetroStation?       @relation("PlaceMetroManual", fields: [metroManualId], references: [id])
  moderatedBy     User?               @relation("PlaceModerator", fields: [moderatedByUserId], references: [id])
  openingHours    OpeningHours?       @relation(fields: [openingHoursId], references: [id])
  ownerBusiness   Business?           @relation("BusinessPlaces", fields: [ownerBusinessId], references: [id])
  parentPlace     Place?              @relation("PlaceHierarchy", fields: [parentPlaceId], references: [id], onDelete: Restrict)
  children        Place[]             @relation("PlaceHierarchy")
  placeGroup      PlaceGroup?         @relation(fields: [placeGroupId], references: [id])
  claimRequests   PlaceClaimRequest[]
  images          PlaceImage[]
  revisions       PlaceRevision[]
  reviews         PlaceReview[]
  slugHistory     PlaceSlugHistory[]
  routeStops      RouteStop[]
  primaryCategory EventCategory?      @relation("PlacePrimaryCategory", fields: [primaryCategoryId], references: [id])
  subcategories   PlaceSubcategory[]

  @@unique([createdByUserId, createRequestId])
  @@index([createdByUserId])
  @@index([ownerBusinessId])
  @@index([status])
  @@index([cityId])
  @@index([googlePlaceId])
  @@index([parentPlaceId])
  @@index([placeKind])
  @@index([placeGroupId])
  @@index([openingHoursId])
  @@index([districtAutoId])
  @@index([districtManualId])
  @@index([metroAutoId])
  @@index([metroManualId])
  @@index([moderatedByUserId])
  @@index([archivedByUserId])
  @@index([archivedAt])
  @@index([status, revisionRequestedAt])
  @@index([primaryCategoryId])
}

/// Подкатегории места (EventCategory с publicationType=PLACE, parentId=primaryCategoryId).
/// position=0 — основная подкатегория. Максимум 3 записи на место.
model PlaceSubcategory {
  placeId    String
  categoryId String
  /// Порядок выбора: 0 = основная подкатегория
  position   Int           @default(0)
  place      Place         @relation(fields: [placeId], references: [id], onDelete: Cascade)
  category   EventCategory @relation("PlaceSubcategoryCategory", fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([placeId, categoryId])
  @@index([placeId, position])
  @@index([categoryId])
}

/// Отзывы о местах из разных источников (mamaGo, Google)
