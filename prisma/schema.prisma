  @@index([status])
  @@index([sourceType])
  @@index([createdAt])
  @@index([uploadedById])
  @@index([checksum])
  @@index([wizardSessionId, status])
  @@index([draftEntityId, draftEntityType, status])
  @@index([status, createdAt])
}

model MediaUsage {
