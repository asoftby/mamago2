  articleId String
  slug      String   @unique
  createdAt DateTime @default(now())
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@index([slug])
}

/// Денормализованный индекс для быстрого поиска. Источник истины — сущности Activity/Offer/Place/Route/Article.
model SearchDocument {
  id          String           @id @default(cuid())
  entityType  SearchEntityType
  entityId    String
  title       String
  searchText  String           @db.Text
  /// Короткое описание для карточки в выпадающем поиске (плоский текст).
  summaryLine String?
  metaLine    String
  imageUrl    String?
  urlPath     String
  isPublished Boolean          @default(false)
  boost       Float            @default(1)
  updatedAt   DateTime         @updatedAt
  createdAt   DateTime         @default(now())

  @@unique([entityType, entityId])
  @@index([isPublished])
}

enum SearchEntityType {
  activity
  offer
  place
  route
  article
}

model RouteStop {
  id                   String   @id @default(cuid())
  routeId              String
  order                Int
  placeId              String?
  googlePlaceId        String?
  lat                  Float?
  lng                  Float?
  address              String?
  customTitle          String?
  note                 String
  photoUrl             String?
  priceType            RouteStopPriceType @default(UNKNOWN)
  priceMin             Float?
  priceMax             Float?
  priceCurrency        String             @default("BYN")
  priceNote            String?
  formattedAddress     String?
  addressComponents    Json?
  rawGooglePayload     Json?
  detectedCountryCode  String?
  detectedCountryName  String?
  detectedCityName     String?
  detectedRegionName   String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  place                Place?   @relation(fields: [placeId], references: [id])
