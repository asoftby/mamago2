  createdAt       DateTime      @default(now())
  createdByUserId String?
  template        EmailTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  createdByUser   User?         @relation("EmailTemplateVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([templateId, version])
  @@index([templateId, createdAt])
  @@index([createdByUserId])
}

/// Opaque tokens for email unsubscribe links.
/// Tokens are random and do not expose userId in URL.
model UnsubscribeToken {
  id        String    @id @default(cuid())
  /// Random opaque token (64 hex chars)
  token     String    @unique
  /// User who can unsubscribe with this token
  userId    String
  /// When token was created
  createdAt DateTime  @default(now())
  /// When token was used (null if not used yet)
  usedAt    DateTime?
  user      User      @relation("UnsubscribeTokens", fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([createdAt])
}

model OpeningHours {
  id             String                  @id @default(cuid())
  mode           OpeningHoursMode        @default(WEEKLY)
  timezone       String                  @default("Europe/Minsk")
  note           String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  offers         Offer[]
  exceptions     OpeningHoursException[]
  rules          OpeningHoursRule[]
  places         Place[]
  placeRevisions PlaceRevision[]         @relation("PlaceRevisionOpeningHours")

  @@index([mode])
}

model OpeningHoursRule {
  id             String                 @id @default(cuid())
  openingHoursId String
  dayOfWeek      DayOfWeek
  isOpen         Boolean                @default(true)
  allDay         Boolean                @default(false)
  intervals      OpeningHoursInterval[]
  openingHours   OpeningHours           @relation(fields: [openingHoursId], references: [id], onDelete: Cascade)

  @@unique([openingHoursId, dayOfWeek])
  @@index([openingHoursId])
}

model OpeningHoursInterval {
  id        String           @id @default(cuid())
  ruleId    String
  startTime String
  endTime   String
  sortOrder Int              @default(0)
  rule      OpeningHoursRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId, sortOrder])
}

model OpeningHoursException {
  id             String                          @id @default(cuid())
  openingHoursId String
  date           String
  isClosed       Boolean                         @default(false)
  allDay         Boolean                         @default(false)
  note           String?
  openingHours   OpeningHours                    @relation(fields: [openingHoursId], references: [id], onDelete: Cascade)
  intervals      OpeningHoursExceptionInterval[]

  @@unique([openingHoursId, date])
  @@index([openingHoursId, date])
}

model OpeningHoursExceptionInterval {
  id          String                @id @default(cuid())
  exceptionId String
  startTime   String
  endTime     String
  sortOrder   Int                   @default(0)
  exception   OpeningHoursException @relation(fields: [exceptionId], references: [id], onDelete: Cascade)

  @@index([exceptionId, sortOrder])
}

model Offer {
  id                       String             @id @default(cuid())
  placeId                  String
  /// Источник контактных данных предложения: manual | place
  contactSource            String?            @default("manual")
  /// Ручной телефон предложения (fallback, если не берём контакты из места)
  contactPhone             String?
  /// Ручной сайт предложения
  contactWebsite           String?
  /// Ручные соцсети предложения (JSON array)
  contactSocialLinks       Json?
  kind                     OfferKind
  title                    String
  description              String?
  coverImage               String?
  /// Видео URL (YouTube, YouTube Shorts, Instagram Reels)
  videoUrl                 String?
  /// Rich-text подпись к цене: что входит, ограничения, условия участия
  priceCaption             String?
  priceFrom                Float?
  priceText                String?
  /// Rich-text детали акций, скидок и специальных условий
  promotionDetails         String?
  /// Акционное предложение (текстовое описание скидки, раннего бронирования и т.д.)
  promotionalOffer         String?
  ageMinMonths             Int?
  ageMaxMonths             Int?
  dateFrom                 DateTime?
  dateTo                   DateTime?
  promoTitle               String?
  promoDescription         String?
  promoUntil               DateTime?
  status                   OfferStatus        @default(DRAFT)
  publishedAt              DateTime?
  rejectionReason          String?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  inheritPlaceOpeningHours Boolean            @default(true)
  openingHoursId           String?
  seoCanonicalUrl          String?
  seoDescription           String?
  seoH1                    String?
  seoJsonLdOverride        Json?
  seoOgDescription         String?
  seoOgImage               String?
  seoOgTitle               String?
  seoRobots                String?
  seoTitle                 String?
  slug                     String?            @unique
  slugUpdatedAt            DateTime?
  seoCanonicalSource       SeoCanonicalSource @default(FALLBACK)
  /// Сигналы DISCOVERY домена (entityType=OFFER), ID SignalDefinition
  discoverySignalIds       String[]           @default([])
  /// Чипы публичной витрины /[city]/classes
  classChipSlugs           String[]           @default([])

  // Настройки записи
  bookingEnabled Boolean      @default(false)
  bookingMode    BookingMode?
  bookingPhone   String?
  bookingNote    String?

  // Gallery images (JSON array of URLs)
  galleryImages            Json?              @default("[]")

  // Camp-specific fields (JSON for MVP, can be normalized later)
  /// Camp sessions with dates (JSON array: [{dateFrom, dateTo}, ...])
  campSessions             Json?
  /// Camp session duration (e.g., "7 дней", "2 недели")
  campSessionDuration      String?
  /// Camp stay duration (e.g., "с 9:00 до 17:00", "круглосуточно")
  campStayDuration         String?
  /// Number of available places
  campPlacesCount          Int?
  /// Group size
  campGroupSize            Int?
  /// Daily schedule description
  campDaySchedule          String?
  /// Can select individual days
  campCanSelectDays        Boolean            @default(false)
  /// Has extended care option
  campHasExtendedCare      Boolean            @default(false)
  /// Тип программы лагеря: городской | выездной | смешанный (wizard CAMP)
  campProgramType          String?

  // Accommodation fields (for CAMP type)
  /// Is accommodation provided
  accommodationProvided    Boolean            @default(false)
  /// Type of accommodation (e.g., "палатки", "коттеджи")
  accommodationType        String?
  /// Адрес проживания (отдельно от площадки)
  accommodationAddress     String?
  /// Описание комнат / расселения
  accommodationRooms       String?
  /// Включённые приёмы питания (JSON string[]: breakfast, lunch, dinner, snacks)
  campIncludedMeals        Json?
  /// Безопасность / охрана
  campSafetyInfo           String?
  /// Медицинское сопровождение
  campMedicalInfo          String?
  /// Accommodation conditions description
  accommodationConditions  String?
  /// Meal information
  mealInfo                 String?
  /// Transfer information
  transferInfo             String?
  /// What to bring
  whatToBring              String?

  boosts          Boost[]
  bookingRequests BookingRequest[]
  offerIdeas      OfferIdea[]
  openingHours    OpeningHours?      @relation(fields: [openingHoursId], references: [id])
  place           Place              @relation(fields: [placeId], references: [id], onDelete: Cascade)
  slugHistory     OfferSlugHistory[]

  @@index([placeId])
  @@index([status])
  @@index([kind])
  @@index([dateFrom])
  @@index([ageMinMonths, ageMaxMonths])
  @@index([openingHoursId])
  @@index([slug])
}

/// Сохранённые предложения в «Идеи» (отдельно от Idea с activityId)
model OfferIdea {
  id        String   @id @default(cuid())
  userId    String
  offerId   String
  createdAt DateTime @default(now())
  offer      Offer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, offerId])
  @@index([userId])
  @@index([offerId])
}

model OfferSlugHistory {
  id        String   @id @default(cuid())
  offerId   String
  slug      String   @unique
  createdAt DateTime @default(now())
  offer     Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([offerId])
  @@index([slug])
}

model Boost {
  id        String   @id @default(cuid())
  offerId   String
  startAt   DateTime
  endAt     DateTime
  createdAt DateTime @default(now())
  offer     Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([offerId])
  @@index([startAt, endAt])
}

model BillingAccount {
  id                  String               @id @default(cuid())
  businessId          String               @unique
  status              BillingAccountStatus @default(ACTIVE)
  depositBalance      Decimal              @default(0) @db.Decimal(10, 2)
  currency            String               @default("BYN")
  lowBalanceThreshold Decimal              @default(20) @db.Decimal(10, 2)
  creditLimit         Decimal              @default(0) @db.Decimal(10, 2)
  suspendedAt         DateTime?
  suspendedReason     String?
  closedAt            DateTime?
  closedReason        String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  business            Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  disputes            BillingDispute[]
  transactions        BillingTransaction[]
  paymentMethods      PaymentMethod[]
  subscriptions       Subscription[]

  @@index([businessId])
  @@index([status])
  @@index([depositBalance])
}

model Plan {
  id               String              @id @default(cuid())
  code             String              @unique
  name             String
  description      String?
  price            Decimal             @db.Decimal(10, 2)
  currency         String              @default("BYN")
  interval         PlanInterval        @default(MONTH)
  maxPlaces        Int                 @default(0)
  maxOffers        Int                 @default(0)
  maxEvents        Int                 @default(0)
  storiesPerMonth  Int                 @default(0)
  hasPriorityBoost Boolean             @default(false)
  hasLeadAccess    Boolean             @default(false)
  hasAnalytics     Boolean             @default(false)
  isActive         Boolean             @default(true)
  isVisible        Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  placements       BusinessPlacement[]
  subscriptions    Subscription[]

  @@index([code])
  @@index([isActive, isVisible])
}

model Subscription {
  id                 String               @id @default(cuid())
  billingAccountId   String
  planId             String
  status             SubscriptionStatus   @default(ACTIVE)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  autoRenew          Boolean              @default(true)
  cancelAtPeriodEnd  Boolean              @default(false)
  canceledAt         DateTime?
  cancelReason       String?
  trialStart         DateTime?
  trialEnd           DateTime?
  metadata           Json?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  transactions       BillingTransaction[]
  billingAccount     BillingAccount       @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)
  plan               Plan                 @relation(fields: [planId], references: [id])

  @@index([billingAccountId])
  @@index([planId])
  @@index([status])
  @@index([currentPeriodEnd])
}

model PaymentMethod {
  id               String               @id @default(cuid())
  billingAccountId String
  type             PaymentMethodType    @default(CARD)
  cardBrand        String?
  cardLast4        String?
  cardExpiryMonth  Int?
  cardExpiryYear   Int?
  bankName         String?
  bankAccountLast4 String?
  isDefault        Boolean              @default(false)
  isActive         Boolean              @default(true)
  providerType     String?
  providerId       String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  transactions     BillingTransaction[]
  billingAccount   BillingAccount       @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)

  @@index([billingAccountId])
  @@index([isDefault, isActive])
}

model BillingTransaction {
  id                  String                   @id @default(cuid())
  billingAccountId    String
  type                BillingTransactionType
  status              BillingTransactionStatus @default(PENDING)
  amount              Decimal                  @db.Decimal(10, 2)
  currency            String                   @default("BYN")
  description         String
  occurredAt          DateTime                 @default(now())
  referenceType       BillingReferenceType     @default(NONE)
  referenceId         String?
  idempotencyKey      String?
  parentTransactionId String?
  paymentMethodId     String?
  subscriptionId      String?
  metadata            Json?
  failureReason       String?
  failureCode         String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  billingAccount      BillingAccount           @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)
  parentTransaction   BillingTransaction?      @relation("TransactionHierarchy", fields: [parentTransactionId], references: [id])
  childTransactions   BillingTransaction[]     @relation("TransactionHierarchy")
  paymentMethod       PaymentMethod?           @relation(fields: [paymentMethodId], references: [id])
  subscription        Subscription?            @relation(fields: [subscriptionId], references: [id])

  @@index([billingAccountId, occurredAt])
  @@index([type])
  @@index([status])
  @@index([referenceType, referenceId])
  @@index([idempotencyKey])
  @@index([parentTransactionId])
  @@index([subscriptionId])
  @@unique([billingAccountId, idempotencyKey])
}

model BillingDispute {
  id               String         @id @default(cuid())
  billingAccountId String
  transactionId    String?
  reason           String
  description      String?
  status           String         @default("OPEN")
  resolvedAt       DateTime?
  resolution       String?
  resolvedByUserId String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  billingAccount   BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)

  @@index([billingAccountId])
  @@index([status])
}

model Promotion {
  id               String                   @id @default(cuid())
  businessId       String
  publicationType  PromotionPublicationType
  publicationId    String
  publicationTitle String
  budget           Decimal                  @db.Decimal(10, 2)
  spent            Decimal                  @default(0) @db.Decimal(10, 2)
  status           PromotionStatus          @default(DRAFT)
  startedAt        DateTime?
  pausedAt         DateTime?
  endedAt          DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  actions          PromotionAction[]
  business         Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, status])
  @@index([publicationType, publicationId, status])
  @@index([createdAt])
}

model PromotionAction {
  id          String              @id @default(cuid())
  promotionId String
  userEventId String              @unique
  actionType  PromotionActionType
  amount      Decimal             @db.Decimal(10, 2)
  createdAt   DateTime            @default(now())
  promotion   Promotion           @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  userEvent   UserEvent           @relation(fields: [userEventId], references: [id], onDelete: Cascade)

  @@index([promotionId, actionType, createdAt])
}

model BusinessContract {
  id                      String                   @id @default(cuid())
  businessId              String
