  requestedDate     DateTime? // Snapshot для Offer или общий fallback
  requestedTime     String? // Snapshot времени (HH:MM)

  // Смена лагеря (snapshot из Offer.campSessions JSON)
  /// ID смены из JSON-массива campSessions (строковый ключ, не FK)
  campShiftId       String?
  /// Название смены (snapshot)
  campShiftTitle    String?
  /// Дата начала смены (snapshot)
  campShiftDateFrom DateTime?
  /// Дата окончания смены (snapshot)
  campShiftDateTo   DateTime?

  // Данные клиента
  customerName    String
  customerPhone   String
  customerEmail   String?
  customerComment String?

  // Данные ребёнка (для лагерей и детских занятий)
  childName String?
  childAge  Int?

  // Количество
  adultsCount   Int @default(1)
  childrenCount Int @default(0)

  // Статус
  status BookingStatus @default(NEW)

  // Timestamps
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  /// Время последнего действия (звонок, смена статуса) — для сортировки stale leads
  lastActivityAt DateTime @default(now())

  // Derived metrics (filled automatically on status transitions)
  /// Время первого подтверждения (NEW → CONFIRMED)
  firstResponseAt     DateTime?
  /// Время завершения (CONFIRMED → COMPLETED)
  completedAt         DateTime?
  /// Время отклонения (NEW|CONFIRMED → REJECTED)
  rejectedAt          DateTime?
  /// Время ответа в минутах (diff firstResponseAt − createdAt)
  responseTimeMinutes Int?

  // Relations
  business   Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  activity   Activity?         @relation(fields: [activityId], references: [id], onDelete: SetNull)
  offer      Offer?            @relation(fields: [offerId], references: [id], onDelete: SetNull)
  place      Place?            @relation(fields: [placeId], references: [id], onDelete: SetNull)
  session    ActivitySession?  @relation(fields: [selectedSessionId], references: [id], onDelete: SetNull)
  activities BookingActivity[]
  feedback   BookingFeedback?

  @@index([businessId])
  @@index([userId])
  @@index([activityId])
  @@index([offerId])
  @@index([placeId])
  @@index([selectedSessionId])
  @@index([campShiftId])
  @@index([status])
  @@index([requestedDate])
  @@index([createdAt])
  @@index([businessId, createdAt])
  @@index([businessId, firstResponseAt])
}

/// Тип события в истории заявки
enum BookingActivityType {
  CREATED
  STATUS_CHANGED
  PHONE_CLICKED
  COMMENT_ADDED
}

/// Актор события: бизнес или система
enum BookingActivityActorType {
  BUSINESS
  SYSTEM
}

/// История событий по заявке (timeline)
model BookingActivity {
  id         String                   @id @default(cuid())
  bookingId  String
  type       BookingActivityType
  actorType  BookingActivityActorType @default(SYSTEM)
  actorId    String?
  /// Дополнительные данные события (JSON)
  payload    Json?
  createdAt  DateTime                 @default(now())

  booking BookingRequest @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@index([bookingId, type])
}

/// Отзыв клиента после завершённой заявки (1–5 звёзд)
/// Только для COMPLETED bookings. Один отзыв на заявку.
model BookingFeedback {
  id        String   @id @default(cuid())
  bookingId String   @unique
  userId    String?
  /// Оценка 1–5
  rating    Int
  /// Необязательный комментарий
  comment   String?
  createdAt DateTime @default(now())

  booking BookingRequest @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user    User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([userId])
  @@index([createdAt])
}

/// Анонимные генерации подборки «Мой план» (ключ anon:UUID или iph:hash).
model GuestUsage {
  id                String   @id @default(cuid())
  anonymousId       String   @unique
  generationsCount  Int      @default(0)
  lastUsedAt        DateTime @default(now()) @updatedAt
  /// Минутное окно (unix-минута) для rate limit
  rateMinuteBucket  Int?
  rateCountInMinute Int      @default(0)

  @@index([generationsCount])
}

/// Quick tags для поиска (отображаются под поисковой строкой)
model SearchQuickTag {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  query     String
  filters   Json?
  cityId    String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  city City? @relation(fields: [cityId], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@index([sortOrder])
  @@index([cityId])
}

/// Search synonyms для улучшения релевантности поиска
model SearchSynonym {
  id        String   @id @default(cuid())
  source    String   @unique
  targets   String[]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([source])
}

/// Search query log для аналитики и zero-result tracking
model SearchQueryLog {
  id                String    @id @default(cuid())
  query             String
  resultsCount      Int
  clickedEntityId   String?
  clickedEntityType String?
  cityId            String?
  userId            String?
  sessionId         String?
  createdAt         DateTime  @default(now())

  city City? @relation(fields: [cityId], references: [id], onDelete: SetNull)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([query])
  @@index([resultsCount])
  @@index([cityId])
  @@index([userId])
  @@index([createdAt])
  @@index([query, resultsCount])
}

/// Search index record для контроля качества индексации
model SearchIndexRecord {
  id          String                 @id @default(cuid())
  entityId    String
  entityType  SearchIndexEntityType
  status      SearchIndexStatus      @default(PENDING)
  searchable  Boolean                @default(true)
  indexedAt   DateTime?
  error       String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@unique([entityId, entityType])
  @@index([entityType])
  @@index([status])
  @@index([searchable])
  @@index([indexedAt])
  @@index([entityType, status])
}

enum SearchIndexEntityType {
  EVENT
  PLACE
  OFFER
  ROUTE
  ARTICLE
}

enum SearchIndexStatus {
  INDEXED
  PENDING
  FAILED
  EXCLUDED
}

/// Search ranking settings для управления весами поиска и рекомендаций
model SearchRankingSettings {
  id              String   @id @default(cuid())
  nearbyBoost     Int      @default(50)  // 0-100: вес близости к пользователю
  freshnessBoost  Int      @default(30)  // 0-100: вес свежести контента
  popularityBoost Int      @default(40)  // 0-100: вес популярности (views, bookings)
  partnerBoost    Int      @default(20)  // 0-100: вес партнерского контента
  ageBoost        Int      @default(60)  // 0-100: вес соответствия возрасту ребенка
  cityBoost       Int      @default(70)  // 0-100: вес соответствия городу пользователя
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([updatedAt])
}

// ============================================================================
// PAGES MODULE
// ============================================================================

/// Управляемые страницы: юридические, маркетинговые, лендинги, FAQ, системные
model Page {
  id              String         @id @default(cuid())
  slug            String         @unique
  title           String
  type            PageType
  status          PageStatus     @default(DRAFT)
  visibility      PageVisibility @default(PUBLIC)
  excerpt         String?
  content         String?
  seoTitle        String?
  seoDescription  String?
  ogImageUrl      String?
  publishedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  createdById     String?
  updatedById     String?
  
  // Relations
  createdBy       User?          @relation("PageCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy       User?          @relation("PageUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([slug])
  @@index([type])
  @@index([status])
  @@index([visibility])
  @@index([publishedAt])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([type, status])
  @@index([status, visibility])
}

/// Системные фильтры разделов подбора (budget, freeOnly и др.).
/// Один тип на раздел; создаётся лениво при первом включении в админке.
model SectionSystemFilter {
  id         String   @id @default(cuid())
  sectionKey String   // kuda | classes | birthday | routes
  type       String   // BUDGET | FREE_ONLY
  enabled    Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([sectionKey, type])
  @@index([sectionKey, enabled])
}

/// Привязка FilterDefinition к разделу (intent) или категории (categoryId).
/// intent-only  → общий фильтр раздела (kuda / classes / birthday / routes).
/// categoryId-only → фильтр конкретной категории каталога.
/// intent+categoryId → переопределение фильтра раздела для категории.
model DiscoveryFilterPlacement {
  id         String           @id @default(cuid())
  filterId   String
  filter     FilterDefinition @relation(fields: [filterId], references: [id], onDelete: Cascade)

  intent     String?          // kuda | classes | birthday | routes
  categoryId String?
  category   EventCategory?   @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  isActive   Boolean          @default(true)
  sortOrder  Int              @default(0)

  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([filterId, intent, categoryId])
  @@index([intent, isActive, sortOrder])
  @@index([categoryId, isActive, sortOrder])
}

enum PageType {
  LEGAL       // Юридические: политика, оферта, условия
  MARKETING   // Маркетинговые: для бизнеса, рекламодателям
  LANDING     // Лендинги и промо-страницы
  FAQ         // Часто задаваемые вопросы
  SYSTEM      // Системные страницы
  SEO         // SEO-страницы
}

enum PageStatus {
  DRAFT       // Черновик
  PUBLISHED   // Опубликовано
  ARCHIVED    // Архив (soft delete)
}

enum PageVisibility {
  PUBLIC      // Публичная (в sitemap, доступна всем)
  PRIVATE     // Приватная (не показывать публично)
  UNLISTED    // По прямой ссылке (не в sitemap)
}
