/// Tracks delivery attempts per channel for each Notification.
/// IN_APP is always created. EMAIL/TELEGRAM are created when dispatch is attempted.
model NotificationDelivery {
  id             String                     @id @default(cuid())
  notificationId String?
  userId         String
  scenario       NotificationScenario?
  channel        NotificationChannel
  status         NotificationDeliveryStatus @default(PENDING)
  dedupeKey      String?
  errorMessage   String?
  payloadJson    Json?
  sentAt         DateTime?
  attemptCount   Int                        @default(0)
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  notification   Notification?              @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User                       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel])
  @@index([notificationId])
  @@index([userId, scenario, channel])
  @@index([dedupeKey])
  @@index([channel, status])
  @@index([scenario, channel, status])
  @@index([status, createdAt])
}

/// Per-user, per-type channel preferences.
/// NULL = use role default from notificationDefaultsByRole config.
model UserNotificationPreference {
  id               String                @id @default(cuid())
  userId           String
  audience         NotificationAudience?
  notificationType NotificationType
  inAppEnabled     Boolean?
  emailEnabled     Boolean?
  telegramEnabled  Boolean?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, notificationType])
  @@index([userId, audience])
  @@index([userId])
}

model DevTelegramBusinessApplication {
  id                String                               @id @default(cuid())
  userId            String
  applicationNumber String
  serviceName       String
  clientName        String
  scheduledFor      DateTime
  status            DevTelegramBusinessApplicationStatus @default(PENDING)
  confirmedAt       DateTime?
  rejectedAt        DateTime?
  createdAt         DateTime                             @default(now())
  updatedAt         DateTime                             @updatedAt
  user              User                                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

