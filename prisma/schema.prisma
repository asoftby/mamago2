model Article {
  id                 String               @id @default(cuid())
  slug               String?              @unique
  slugUpdatedAt      DateTime?
  title              String
  subtitle           String?
  excerpt            String?
  /// MVP: `{ "version": 1, "blocks": ArticleBlock[] }` — см. `lib/publications/articleMvp.ts`
  contentJson        Json?
  heroImage          String?
  coverImageId       String?
