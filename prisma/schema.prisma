/// Источник импорта (сайт, фид, API и т.д.)
model ImportSource {
  id                  String              @id @default(cuid())
  name                String
  slug                String              @unique
  type                ImportSourceType
  status              ImportSourceStatus  @default(ACTIVE)
  baseUrl             String?
  parserKey           String?
  fetchStrategy       ImportFetchStrategy @default(HTML_SCRAPE)
  isTrusted           Boolean             @default(false)
  isAutoUpdate        Boolean             @default(false)
  defaultEntity       ImportEntityType?
  rateLimitMs         Int?
  notes               String?
  lastRunAt           DateTime?
  lastSuccessAt       DateTime?
  lastErrorAt         DateTime?
  lastErrorMessage    String?
  cityId              String?
  isActive            Boolean             @default(true)
  archivedAt          DateTime?
  crawlMaxPages       Int?
  crawlMaxDetailLinks Int?
  crawlMaxRecords     Int?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  city    City?            @relation("ImportSourceCity", fields: [cityId], references: [id])
  runs    ImportRun[]
  records ImportedRecord[]

  @@index([status])
  @@index([type])
  @@index([cityId])
  @@index([archivedAt])
  @@index([isActive])
}

/// Один запуск импорта из источника
model ImportRun {
  id            String            @id @default(cuid())
  sourceId      String
  status        ImportRunStatus   @default(PENDING)
  startedAt     DateTime?
  finishedAt    DateTime?
  totalFetched  Int               @default(0)
  totalParsed   Int               @default(0)
  totalCreated  Int               @default(0)
  totalUpdated  Int               @default(0)
  totalSkipped  Int               @default(0)
  totalRejected Int               @default(0)
  totalErrors   Int               @default(0)
  triggerType   ImportTriggerType @default(MANUAL)
  triggerUserId String?
  errorMessage  String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  isArchived    Boolean           @default(false)

  source  ImportSource     @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  records ImportedRecord[]

  @@index([sourceId])
  @@index([status])
  @@index([sourceId, status])
  @@index([createdAt])
  @@index([isArchived])
}

/// Одна импортированная запись (сырые данные + статусы pipeline)
model ImportedRecord {
  id                  String                @id @default(cuid())
  sourceId            String
  runId               String?
  externalId          String?
  sourceUrl           String?
  canonicalSourceUrl  String?
  entityTypeHint      ImportEntityType?
  rawPayload          Json?
  rawText             String?
  contentHash         String?
  sourceUpdatedAt     DateTime?
  parseStatus         ImportParseStatus     @default(PENDING)
  normalizeStatus     ImportNormalizeStatus @default(PENDING)
  matchStatus         ImportMatchStatus     @default(PENDING)
  reviewStatus        ImportReviewStatus    @default(PENDING)
  confidenceScore     Float?
  qualityScore        Float?
  normalizedData      Json?
  matchCandidates     Json?
  reviewDecision      Json?
  publishedPlaceId    String?
  publishedActivityId String?
  errorMessage        String?
  fetchedAt           DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  applyResult         Json?

  reviewTask        ImportReviewTask?
  publishedActivity Activity?         @relation("ImportedRecordActivity", fields: [publishedActivityId], references: [id])
  publishedPlace    Place?            @relation("ImportedRecordPlace", fields: [publishedPlaceId], references: [id])
  run               ImportRun?        @relation(fields: [runId], references: [id])
  source            ImportSource      @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId, reviewStatus])
  @@index([sourceId, externalId])
  @@index([contentHash])
  @@index([runId])
  @@index([runId, reviewStatus])
  @@index([publishedPlaceId])
  @@index([publishedActivityId])
  @@index([parseStatus])
  @@index([normalizeStatus])
  @@index([matchStatus])
}

/// Задача ревью для конкретной импортированной записи
model ImportReviewTask {
  id               String                 @id @default(cuid())
  importedRecordId String                 @unique
  status           ImportReviewTaskStatus @default(PENDING)
  priority         Int                    @default(0)
  suggestedAction  ImportSuggestedAction?
  decision         ImportDecision?
  reviewerUserId   String?
  reviewedAt       DateTime?
  notes            String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  importedRecord ImportedRecord @relation(fields: [importedRecordId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([priority])
  @@index([status, priority])
}

/// Блокировка поля сущности от перезаписи при повторном импорте
model ImportFieldOverride {
  id              String              @id @default(cuid())
  entityType      ImportEntityType
  entityId        String
  fieldName       String
  lockMode        ImportFieldLockMode @default(LOCKED)
  reason          String?
  createdByUserId String?
  createdAt       DateTime            @default(now())

  @@unique([entityType, entityId, fieldName])
  @@index([entityType, entityId])
}

/// Оценки маршрутов от пользователей (уникальный голос на маршрут от пользователя/IP)
model RouteRating {
  id         String   @id @default(cuid())
  routeId    String
  ratingType String // "like" | "neutral" | "dislike"
  /// Идентификатор голосующего: userId (если авторизован) или IP-адрес (для гостей)
  identifier String
  userId     String?
  createdAt  DateTime @default(now())
  route      Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([routeId, identifier])
  @@index([routeId])
  @@index([routeId, ratingType])
  @@index([identifier])
  @@index([userId])
}

