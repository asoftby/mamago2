// Prisma ORM 7 schema (no datasource url here)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  BUSINESS_OWNER
  MODERATOR
  ADMIN
}

model Healthcheck {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
}

// Authentication models
model User {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
  role         Role   @default(USER)

  resetToken        String?
  resetTokenExpires DateTime?

  phoneE164       String?   @unique
  phoneVerifiedAt DateTime?

  sessions                      Session[]
  business                      Business? // One business per owner (MVP)
  children                      Child[]
  ideas                         Idea[]
  planItems                     PlanItem[]
  phoneOtps                     PhoneOtp[]
  reviewedBusinessVerifications BusinessVerificationLog[] @relation("ReviewedBy")
  places                        Place[]                   @relation("PlaceOwner")
  moderatedPlaces               Place[]                   @relation("PlaceModerator")
  archivedPlaces                Place[]                   @relation("PlaceArchiver")
  placeRevisions                PlaceRevision[]           @relation("PlaceRevisionReviewer")
  moderationLogs                ModerationLog[]           @relation("ModerationReviewer")
  activities                    Activity[]                @relation("ActivityOwner")
  placeClaimRequests            PlaceClaimRequest[]       @relation("ClaimRequester")
  reviewedPlaceClaimRequests    PlaceClaimRequest[]       @relation("ClaimReviewer")
  tempMedia                     TempMedia[]
  notifications                 Notification[]
  contentEdits                  ContentEditLog[]          @relation("ContentEditor")
  createdImprovementRequests    ImprovementRequest[]      @relation("ImprovementRequestCreator")
  assignedImprovementRequests   ImprovementRequest[]      @relation("ImprovementRequestAssignee")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([resetToken])
  @@index([phoneE164])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
}

model PhoneOtp {
  id         String   @id @default(cuid())
  userId     String
  phoneE164  String
  purpose    String
  codeHash   String
  expiresAt  DateTime
  lastSentAt DateTime
  attempts   Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, phoneE164, purpose])
  @@index([userId, purpose])
  @@index([phoneE164, purpose])
}

model Child {
  id        String   @id @default(cuid())
  name      String
  birthDate DateTime
  interests String?
  parentId  String

  parent User @relation(fields: [parentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
}

// User saved ideas (activities they want to remember)
model Idea {
  id         String @id @default(cuid())
  userId     String
  activityId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, activityId])
  @@index([userId])
}

// User plan items (activities scheduled for specific dates)
model PlanItem {
  id         String    @id @default(cuid())
  userId     String
  activityId String?
  date       String // YYYY-MM-DD format
  startsAt   DateTime? // Optional specific time

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity Activity? @relation(fields: [activityId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId, date])
  @@index([userId])
  @@index([activityId])
}

enum UiPlacement {
  PRIMARY
  SECONDARY
  HIDDEN
}

model SignalDefinition {
  id       String         @id @default(cuid())
  slug     String         @unique
  title    String
  order    Int            @default(0)
  isActive Boolean        @default(true)
  options  SignalOption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SignalOption {
  id           String  @id @default(cuid())
  definitionId String
  label        String
  value        String
  order        Int     @default(0)
  isActive     Boolean @default(true)

  definition SignalDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([definitionId, value])
  @@index([definitionId, isActive, order])
}

model FilterDefinition {
  id         String         @id @default(cuid())
  slug       String         @unique
  title      String
  type       String // single | multi
  ui         String // tabs | dropdown | multi_tabs
  order      Int            @default(0) // Legacy, can be removed or mapped to orderIndex
  orderIndex Int            @default(0)
  placement  UiPlacement    @default(PRIMARY)
  isActive   Boolean        @default(true)
  options    FilterOption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FilterOption {
  id         String  @id @default(cuid())
  filterId   String
  label      String
  value      String
  order      Int     @default(0) // Legacy
  orderIndex Int     @default(0)
  isActive   Boolean @default(true)

  filter                FilterDefinition       @relation(fields: [filterId], references: [id], onDelete: Cascade)
  activityFilterOptions ActivityFilterOption[]

  @@unique([filterId, value])
  @@index([filterId, isActive, order])
}

model City {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  lat       Float?
  lng       Float?
  
  // Google Places matching
  googleName  String? // Primary Google name (e.g., "Minsk")
  googleNames Json?   // Alternative names array for matching
  
  // City center for coordinate-based resolution
  centerLat Float?
  centerLng Float?
  radiusKm  Float?  // Search radius for coordinate-based city matching (e.g., 40 for Minsk)
  
  // Metro configuration
  hasMetro          Boolean @default(false)
  metroMaxDistanceM Int?    // Max distance to show metro (e.g., 2500 for Minsk)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  districts     District[]
  metroStations MetroStation[]
  places        Place[]          @relation("PlaceCity")
  placeRevisions PlaceRevision[] @relation("PlaceRevisionCity")

  @@index([slug])
  @@index([googleName])
}

model District {
  id        String   @id @default(cuid())
  cityId    String
  name      String
  centerLat Float? // Centroid latitude for MVP geo enrichment
  centerLng Float? // Centroid longitude for MVP geo enrichment
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  city                City    @relation(fields: [cityId], references: [id], onDelete: Cascade)
  placesAutoAssigned  Place[] @relation("PlaceDistrictAuto")
  placesManualPicked  Place[] @relation("PlaceDistrictManual")

  @@unique([cityId, name])
  @@index([cityId])
}

model MetroStation {
  id     String @id @default(cuid())
  cityId String
  name   String
  lat    Float
  lng    Float

  osmType String
  osmId   String
  source  String @default("OSM")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  city               City       @relation(fields: [cityId], references: [id], onDelete: Cascade)
  activities         Activity[]
  placesAutoAssigned Place[]    @relation("PlaceMetroAuto")
  placesManualPicked Place[]    @relation("PlaceMetroManual")

  @@unique([cityId, osmType, osmId])
  @@unique([cityId, name])
  @@index([cityId])
}

model Activity {
  id     String       @id @default(cuid())
  placeId String?     // Required for EVENT/PERMANENT/COURSE/OFFER; nullable for ROUTE
  
  // Activity classification
  type   ActivityType
  status ContentStatus @default(DRAFT)
  
  // Basic info
  title       String
  shortDesc   String
  description String?
  
  // Age targeting
  ageTags String[] // e.g., ["0-3", "3-7", "7-12"]
  
  // Schedule
  scheduleMode      ScheduleMode
  scheduleJson      Json? // Payload depends on scheduleMode
  nextOccurrenceAt  DateTime? // Denormalized for "Today/Tomorrow/Weekend/Week" queries
  
  // Pricing (optional)
  priceFrom    Float?
  priceTo      Float?
  priceText    String? // e.g., "от 50 BYN", "бесплатно"
  currency     String? @default("BYN")
  
  // Images
  coverImageId String?
  
  // Business ownership
  ownerUserId String
  
  // Legacy fields (keep for backward compatibility, will migrate later)
  cityId         String?
  metroStationId String?
  businessId     String?
  createdBy      String?
  coverImageUrl  String?
  ageLabel       String?
  ageMinMonths   Int?
  ageMaxMonths   Int?
  
  // Relations
  place         Place?                 @relation("PlaceActivities", fields: [placeId], references: [id], onDelete: Restrict)
  owner         User                   @relation(fields: [ownerUserId], references: [id], onDelete: Cascade, name: "ActivityOwner")
  metroStation  MetroStation?          @relation(fields: [metroStationId], references: [id])
  filterOptions ActivityFilterOption[]
  sessions      ActivitySession[]
  planItems     PlanItem[]
  images        ActivityImage[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([placeId])
  @@index([type])
  @@index([status])
  @@index([scheduleMode])
  @@index([nextOccurrenceAt])
  @@index([ownerUserId])
  @@index([ageMinMonths, ageMaxMonths])
  @@index([businessId])
  @@index([cityId])
}

// Activity images
model ActivityImage {
  id         String @id @default(cuid())
  activityId String
  url        String
  width      Int?
  height     Int?
  blurhash   String?
  sortOrder  Int    @default(0)
  
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  
  @@index([activityId, sortOrder])
}

// Activity sessions (specific dates/times when activity happens)
model ActivitySession {
  id         String   @id @default(cuid())
  activityId String
  startsAt   DateTime

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([activityId])
  @@index([startsAt])
}

model ActivityFilterOption {
  id             String @id @default(cuid())
  activityId     String
  filterOptionId String

  activity     Activity     @relation(fields: [activityId], references: [id], onDelete: Cascade)
  filterOption FilterOption @relation(fields: [filterOptionId], references: [id], onDelete: Cascade)

  @@unique([activityId, filterOptionId])
  @@index([filterOptionId])
}

// ============================================
// BUSINESS CABINET MODELS
// ============================================

// Enums for Business Cabinet
enum OfferKind {
  EVENT
  SERVICE
}

enum OfferStatus {
  DRAFT
  PENDING
  PUBLISHED
  REJECTED
}

enum BusinessStatus {
  DRAFT
  PENDING_VERIFICATION
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum BusinessVerificationStatus {
  DRAFT
  PENDING
  NEEDS_INFO
  APPROVED
  REJECTED
}

// Content status (unified for Place, Activity, etc.)
enum ContentStatus {
  DRAFT
  PENDING
  PUBLISHED
  NEEDS_REVISION  // Renamed from NEEDS_CHANGES for consistency
  REJECTED
}

// Activity type (determines section classification)
enum ActivityType {
  EVENT         // Разовое мероприятие → "Куда пойти"
  PERMANENT     // Постоянное место → "Куда пойти" + "Всегда рядом"
  COURSE        // Курс/занятие → "Занятия"
  ROUTE         // Маршрут (без привязки к месту) → "Куда пойти"
  OFFER         // Предложение для ДР → "Куда пойти" (для будущего конструктора ДР)
}

// Schedule mode (how activity repeats)
enum ScheduleMode {
  ONE_TIME    // Одна дата/время (EVENT)
  MULTI_DATE  // Несколько конкретных дат (EVENT)
  RECURRING   // Повторяющееся расписание (COURSE, PERMANENT)
  ON_DEMAND   // По запросу (PERMANENT, COURSE)
  ALWAYS      // Всегда доступно (PERMANENT)
}

// Location source for Place
enum LocationSource {
  GOOGLE
  MANUAL
}

// Place image kind
enum PlaceImageKind {
  LOGO
  GALLERY
}

// Place kind (hierarchy support)
enum PlaceKind {
  STANDALONE // Обычное отдельное место
  COMPLEX    // Торговый центр / парк / большой объект
  UNIT       // Точка внутри комплекса (павильон, островок)
}

// Place revision status (for post-publication edits)
enum PlaceRevisionStatus {
  DRAFT
  PENDING
  NEEDS_REVISION
  APPROVED
  REJECTED
}

// Moderation entity type (polymorphic)
enum ModerationEntityType {
  PLACE
  ACTIVITY
}

// Moderation action
enum ModerationAction {
  SUBMIT
  APPROVE
  NEEDS_REVISION  // Renamed from NEEDS_CHANGES for consistency
  REJECT
}

// Content edit type (for micro-edits)
enum ContentEditType {
  TYPO
  PUNCTUATION
  FORMATTING
  CAPITALIZATION
  PHONE_NORMALIZATION
  LINK_NORMALIZATION
  WHITESPACE_CLEANUP
  OTHER
}

// Improvement request status
enum ImprovementRequestStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CANCELLED
}

// Improvement request severity
enum ImprovementSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// Business entity
model Business {
  id          String @id @default(cuid())
  name        String
  ownerUserId String @unique // One business per owner (MVP)

  // Onboarding fields
  unp       String?
  legalName String?
  phone     String?
  status    BusinessStatus @default(DRAFT)

  // Verification fields
  verificationStatus BusinessVerificationStatus @default(DRAFT)
  submittedAt        DateTime?
  reviewedAt         DateTime?
  reviewedByUserId   String?
  reviewNote         String?
  approvedAt         DateTime?
  rejectedAt         DateTime?
  isVerified         Boolean                    @default(false)

  owner            User                      @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  verificationLogs BusinessVerificationLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerUserId])
  @@index([status])
  @@index([verificationStatus])
}

// Business verification audit log
model BusinessVerificationLog {
  id               String                     @id @default(cuid())
  businessId       String
  statusFrom       BusinessVerificationStatus
  statusTo         BusinessVerificationStatus
  note             String?
  reviewedByUserId String?

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  reviewedBy User?    @relation(fields: [reviewedByUserId], references: [id], onDelete: SetNull, name: "ReviewedBy")

  createdAt DateTime @default(now())

  @@index([businessId, createdAt])
}

// Place entity (location/venue profile)
model Place {
  id          String        @id @default(cuid())
  ownerUserId String
  status      ContentStatus @default(DRAFT)

  // SEO-friendly URL slug
  slug String? @unique
  slugUpdatedAt DateTime? // Track when slug was last changed

  // Idempotency key for creation (prevents duplicate places)
  createRequestId String?

  // Required fields for submission
  title     String
  category  String // e.g., "cafe", "museum", "park"
  shortDesc String // Short description for cards

  // Short address for disambiguation (e.g., "Ратомская, 7")
  shortAddress String?

  // Optional SEO description
  description String?

  // Logo image (required for publish, validated at API level)
  logoImageId String?

  // Google Places data
  googlePlaceId  String? // Allow multiple businesses to add same Google place
  lat            Float?
  lng            Float?
  formattedAddr  String?
  addressJson    Json? // Full Google address components
  countryCode    String?
  cityId         String?
  locationSource LocationSource @default(MANUAL)
  customAddress  String? // For MANUAL location source

  // Geo enrichment (district & metro)
  districtAutoId      String? // Auto-determined district
  districtManualId    String? // User-selected district (overrides auto)
  metroAutoId         String? // Auto-determined nearest metro
  metroAutoDistanceM  Int?    // Distance to auto metro in meters
  metroManualId       String? // User-selected metro (overrides auto)
  metroManualDistanceM Int?   // Distance to manual metro in meters

  // Hierarchy support (Complex → Units)
  placeKind     PlaceKind @default(STANDALONE)
  parentPlaceId String?
  unitLabel     String? // e.g., "2 этаж, павильон A12"
  floor         String? // e.g., "2"
  unit          String? // e.g., "A12"

  // Contact information
  phone           String?
  website         String?
  instagramHandle String?
  instagramUrl    String?

  // Tags (arrays)
  ageTags       String[] // e.g., ["0-3", "3-7", "7-12"]
  visitFormats  String[] // e.g., ["indoor", "outdoor", "online"]
  activityTypes String[] // e.g., ["sports", "arts", "education"]

  // Moderation metadata
  moderatorComment      String?   // Explanation of required fixes
  moderationReviewedAt  DateTime? // When moderation was completed
  moderatedByUserId     String?   // Admin/moderator who reviewed
  revisionRequestedAt   DateTime? // When NEEDS_REVISION was assigned
  revisionResubmittedAt DateTime? // When business resubmitted after fixes

  // Archive metadata (soft delete)
  archivedAt       DateTime? // When place was archived
  archivedByUserId String?   // User who archived (owner or admin)

  // Improvement request tracking
  hasActiveImprovementRequests Boolean @default(false)

  // Relations
  archivedBy     User?         @relation(fields: [archivedByUserId], references: [id], onDelete: SetNull, name: "PlaceArchiver")
  owner          User          @relation(fields: [ownerUserId], references: [id], onDelete: Cascade, name: "PlaceOwner")
  moderatedBy    User?         @relation(fields: [moderatedByUserId], references: [id], onDelete: SetNull, name: "PlaceModerator")
  city           City?         @relation(fields: [cityId], references: [id], name: "PlaceCity")
  districtAuto   District?     @relation(fields: [districtAutoId], references: [id], onDelete: SetNull, name: "PlaceDistrictAuto")
  districtManual District?     @relation(fields: [districtManualId], references: [id], onDelete: SetNull, name: "PlaceDistrictManual")
  metroAuto      MetroStation? @relation(fields: [metroAutoId], references: [id], onDelete: SetNull, name: "PlaceMetroAuto")
  metroManual    MetroStation? @relation(fields: [metroManualId], references: [id], onDelete: SetNull, name: "PlaceMetroManual")
  parentPlace    Place?        @relation("PlaceHierarchy", fields: [parentPlaceId], references: [id], onDelete: Restrict)
  children       Place[]       @relation("PlaceHierarchy")
  images         PlaceImage[]
  offers         Offer[]
  activities     Activity[]          @relation("PlaceActivities")
  claimRequests  PlaceClaimRequest[]
  revisions      PlaceRevision[]     // Post-publication edit revisions
  slugHistory    PlaceSlugHistory[]  // Historical slugs for redirects

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerUserId])
  @@index([status])
  @@index([cityId])
  @@index([googlePlaceId]) // Index for performance (not unique - multiple businesses can add same place)
  @@index([parentPlaceId])
  @@index([placeKind])
  @@index([districtAutoId])
  @@index([districtManualId])
  @@index([metroAutoId])
  @@index([metroManualId])
  @@index([moderatedByUserId])
  @@index([archivedByUserId])
  @@index([archivedAt])
  @@index([status, revisionRequestedAt]) // For filtering expired revisions
  @@unique([ownerUserId, createRequestId]) // Prevent duplicate creation with same request ID
}

// Place revision (post-publication edits)
// Stores pending changes to published Places
// Only one active revision (DRAFT/PENDING/NEEDS_REVISION) per Place allowed
model PlaceRevision {
  id        String               @id @default(cuid())
  placeId   String
  status    PlaceRevisionStatus  @default(DRAFT)

  // Link to improvement request (if this revision is in response to one)
  improvementRequestId String?

  // Moderation metadata
  moderatorComment      String?   // Admin feedback
  submittedAt           DateTime? // When submitted for moderation
  reviewedAt            DateTime? // When admin reviewed
  reviewedByUserId      String?   // Admin who reviewed
  revisionRequestedAt   DateTime? // When NEEDS_REVISION assigned
  revisionResubmittedAt DateTime? // When resubmitted after fixes

  // Snapshot of editable Place fields
  // These fields mirror the Place model for fields that can be edited post-publication
  title     String?
  category  String?
  shortDesc String?
  description String?
  logoImageId String?

  // Location data
  googlePlaceId  String?
  lat            Float?
  lng            Float?
  formattedAddr  String?
  addressJson    Json?
  countryCode    String?
  cityId         String?
  locationSource LocationSource?
  customAddress  String?

  // Geo enrichment
  districtAutoId       String?
  districtManualId     String?
  metroAutoId          String?
  metroAutoDistanceM   Int?
  metroManualId        String?
  metroManualDistanceM Int?

  // Hierarchy
  placeKind     PlaceKind?
  parentPlaceId String?
  unitLabel     String?
  floor         String?
  unit          String?

  // Contacts
  phone           String?
  website         String?
  instagramHandle String?
  instagramUrl    String?

  // Tags
  ageTags       String[]
  visitFormats  String[]
  activityTypes String[]

  // Relations
  place      Place                 @relation(fields: [placeId], references: [id], onDelete: Cascade)
  reviewedBy User?                 @relation(fields: [reviewedByUserId], references: [id], onDelete: SetNull, name: "PlaceRevisionReviewer")
  city       City?                 @relation(fields: [cityId], references: [id], name: "PlaceRevisionCity")
  images     PlaceRevisionImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([placeId, status])
  @@index([status])
  @@index([reviewedByUserId])
  @@index([status, revisionRequestedAt]) // For filtering expired revisions
  @@index([placeId, createdAt])
}

// Place revision images (snapshots for revision)
model PlaceRevisionImage {
  id         String         @id @default(cuid())
  revisionId String
  kind       PlaceImageKind
  url        String
  width      Int?
  height     Int?
  blurhash   String?
  sortOrder  Int            @default(0)

  revision PlaceRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([revisionId, kind, sortOrder])
}

// Place claim request (user requests ownership of existing place)
model PlaceClaimRequest {
  id               String   @id @default(cuid())
  placeId          String
  userId           String
  businessId       String?
  status           String   @default("PENDING") // PENDING | APPROVED | REJECTED
  note             String?
  reviewedAt       DateTime?
  reviewedByUserId String?

  place      Place  @relation(fields: [placeId], references: [id], onDelete: Cascade)
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade, name: "ClaimRequester")
  reviewedBy User?  @relation(fields: [reviewedByUserId], references: [id], onDelete: SetNull, name: "ClaimReviewer")

  createdAt DateTime @default(now())

  @@index([placeId, status])
  @@index([userId, createdAt])
  @@index([status])
}

// Place slug history (for SEO-friendly redirects)
// Stores old slugs when a place's slug changes
model PlaceSlugHistory {
  id        String   @id @default(cuid())
  placeId   String
  slug      String   @unique // Old slug that should redirect to current place
  createdAt DateTime @default(now())

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@index([placeId])
  @@index([slug])
}

// Place images (logo and gallery)
model PlaceImage {
  id        String         @id @default(cuid())
  placeId   String
  kind      PlaceImageKind
  url       String
  width     Int?
  height    Int?
  blurhash  String?
  sortOrder Int            @default(0)

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([placeId, kind, sortOrder])
}

// Temporary media for wizard sessions (before Place creation)
enum TempMediaKind {
  PLACE_LOGO
  PLACE_GALLERY
  ACTIVITY_COVER
  ACTIVITY_GALLERY
}

enum TempMediaStatus {
  TEMP      // Uploaded but not attached to entity
  ATTACHED  // Attached to entity (Place/Activity)
  DELETED   // Marked for deletion
}

model TempMedia {
  id               String          @id @default(cuid())
  ownerUserId      String
  wizardSessionId  String          // UUID for wizard session
  
  // File metadata
  url              String
  width            Int?
  height           Int?
  blurhash         String?
  mimeType         String?
  sizeBytes        Int?
  
  // Classification
  kind             TempMediaKind
  sortOrder        Int             @default(0)
  status           TempMediaStatus @default(TEMP)
  
  // Attachment (set when entity is created)
  placeId          String?
  activityId       String?
  
  owner            User            @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  
  @@index([ownerUserId, wizardSessionId, status])
  @@index([wizardSessionId, kind, sortOrder])
  @@index([status, createdAt]) // For cleanup jobs
}

// Notification system
model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  
  // Entity reference (polymorphic)
  entityType String? // PLACE, ACTIVITY, etc.
  entityId   String?
  
  // Delivery status
  isRead    Boolean  @default(false)
  readAt    DateTime?
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  
  @@index([userId, isRead, createdAt])
  @@index([entityType, entityId])
}

enum NotificationType {
  PLACE_APPROVED
  PLACE_NEEDS_CHANGES
  PLACE_REJECTED
  PLACE_UPDATE_APPROVED
  PLACE_UPDATE_NEEDS_REVISION
  PLACE_UPDATE_REJECTED
  ACTIVITY_APPROVED
  ACTIVITY_NEEDS_CHANGES
  ACTIVITY_REJECTED
  SYSTEM
}

// Unified moderation log (polymorphic for Place, Activity, etc.)
model ModerationLog {
  id               String               @id @default(cuid())
  entityType       ModerationEntityType
  entityId         String
  action           ModerationAction
  message          String?
  reviewedByUserId String?

  reviewedBy User? @relation(fields: [reviewedByUserId], references: [id], onDelete: SetNull, name: "ModerationReviewer")

  createdAt DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([reviewedByUserId])
}

// Content edit log (micro-edits by moderators)
model ContentEditLog {
  id          String          @id @default(cuid())
  entityType  String          // "PLACE", "ACTIVITY", etc. (string for flexibility)
  entityId    String
  moderatorId String
  fieldName   String
  oldValue    String?
  newValue    String?
  editType    ContentEditType
  comment     String?

  moderator User @relation(fields: [moderatorId], references: [id], onDelete: Cascade, name: "ContentEditor")

  createdAt DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([moderatorId, createdAt])
  @@index([editType])
}

// Improvement request (post-publication quality control)
model ImprovementRequest {
  id                    String                    @id @default(cuid())
  entityType            String                    // "PLACE", "ACTIVITY", etc.
  entityId              String
  createdByModeratorId  String
  assignedToUserId      String
  status                ImprovementRequestStatus  @default(OPEN)
  severity              ImprovementSeverity       @default(MEDIUM)
  title                 String
  description           String
  requestedChanges      Json?
  dueAt                 DateTime?
  resolvedAt            DateTime?
  resolvedByRevisionId  String?

  createdByModerator User @relation(fields: [createdByModeratorId], references: [id], onDelete: Cascade, name: "ImprovementRequestCreator")
  assignedToUser     User @relation(fields: [assignedToUserId], references: [id], onDelete: Cascade, name: "ImprovementRequestAssignee")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entityType, entityId, status])
  @@index([assignedToUserId, status, createdAt])
  @@index([createdByModeratorId, createdAt])
  @@index([status, severity])
  @@index([dueAt])
}

// Offer entity (EVENT or SERVICE)
model Offer {
  id          String    @id @default(cuid())
  placeId     String
  kind        OfferKind
  title       String
  description String?
  coverImage  String?
  priceFrom   Float?
  priceText   String?

  // Age range in months (easier filtering + indexing than string array)
  ageMinMonths Int?
  ageMaxMonths Int?

  // Date fields (required for EVENT, must be null for SERVICE)
  // Validation enforced at application level
  dateFrom DateTime?
  dateTo   DateTime?

  // Promo attributes (NOT separate entity)
  promoTitle       String?
  promoDescription String?
  promoUntil       DateTime?

  // Status workflow
  status          OfferStatus @default(DRAFT)
  publishedAt     DateTime?
  rejectionReason String?

  place  Place   @relation(fields: [placeId], references: [id], onDelete: Cascade)
  boosts Boost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([placeId])
  @@index([status])
  @@index([kind])
  @@index([dateFrom])
  @@index([ageMinMonths, ageMaxMonths])
}

// Boost entity (ranking modifier only)
model Boost {
  id      String   @id @default(cuid())
  offerId String
  startAt DateTime
  endAt   DateTime

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([offerId])
  @@index([startAt, endAt])
}
