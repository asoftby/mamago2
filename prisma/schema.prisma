model Notification {
  id         String                 @id @default(cuid())
  userId     String
  audience   NotificationAudience?
  type       NotificationType
  scenario   NotificationScenario?
  title      String
  body       String
  entityType String?
  entityId   String?
  isRead     Boolean                @default(false)
  readAt     DateTime?
  /// Первый просмотр в центре уведомлений; null = «новое» для badge и сортировки
  seenAt     DateTime?
  createdAt  DateTime               @default(now())
  ctaLabel   String?
  ctaAction  String?
  /// Закреплённые уведомления (welcome и т.п.) — показываются выше в списке
  isPinned   Boolean                @default(false)
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([userId, audience, createdAt])
  @@index([userId, scenario, createdAt])
  @@index([userId, isPinned, createdAt])
  @@index([userId, isRead, createdAt])
  @@index([userId, seenAt])
  @@index([entityType, entityId])
}

/// Broadcast-сообщения от администратора (новости, объявления, системные).
/// При публикации fan-out'ятся в Notification для целевой аудитории.
model AdminBroadcast {
  id             String            @id @default(cuid())
  title          String            @db.VarChar(200)
  summary        String?           @db.VarChar(500)
  body           String
  type           BroadcastType
  priority       BroadcastPriority @default(NORMAL)
  audienceType   AudienceType      @default(BUSINESS)
  status         BroadcastStatus   @default(DRAFT)
  coverImageUrl  String?
  ctaLabel       String?           @db.VarChar(100)
  ctaUrl         String?           @db.VarChar(2000)
  showInInbox    Boolean           @default(true)
  sendEmail      Boolean           @default(false)
  pinToDashboard Boolean           @default(false)
  publishedAt    DateTime?
  scheduledAt    DateTime?
  createdById    String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  createdBy      User              @relation("AdminBroadcastCreator", fields: [createdById], references: [id])

  @@index([status, publishedAt])
  @@index([audienceType, status])
  @@index([createdById])
}

enum BroadcastType {
  NEWS
  ANNOUNCEMENT
  SYSTEM
}

enum BroadcastPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum AudienceType {
  BUSINESS
  USER
  ALL
}

enum BroadcastStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

