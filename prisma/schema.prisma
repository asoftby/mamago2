generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Healthcheck {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
}

model User {
  id                                String                           @id @default(cuid())
  email                             String                           @unique
  passwordHash                      String
  role                              Role                             @default(USER)
  createdAt                         DateTime                         @default(now())
  updatedAt                         DateTime                         @updatedAt
  resetToken                        String?
  resetTokenExpires                 DateTime?
  emailVerificationToken            String?
  emailVerificationExpires          DateTime?
  phoneE164                         String?                          @unique
  phoneVerifiedAt                   DateTime?
  emailVerifiedAt                   DateTime?
  lastVerificationEmailSentAt       DateTime?
  lastLoginAt                       DateTime?
  deletedAt                         DateTime?
  status                            UserStatus                       @default(ACTIVE)
  statusReason                      String?
  suspendedUntil                    DateTime?
  avatarUrl                         String?
  displayName                       String?
  /// Дочерний SignalDefinition (parent.slug = leisure-format), один
  leisureFormatSignalId             String?
  /// Дочерние SignalDefinition (parent.slug = preferences), макс. 3 в UI
  preferenceSignalIds               String[]                         @default([])
  /// Сигналы PROFILE домена, ID SignalDefinition
  profileSignalIds                  String[]                         @default([])
  /// Роль в семье (блок «Моя семья»): MOM | DAD | GRANDMA | GRANDPA | ADULT
  familyRole                        String?
  ageBandLabel                      String?
  preferenceSummary                 String?
  leisureFormatSummary              String?
  /// Пользователь подключил Telegram (бот / канал уведомлений)
  telegramConnected                 Boolean                          @default(false)
  telegramId                        String?                          @unique
  telegramUsername                  String?
  /// Когда закрыл soft-prompt подключения Telegram (повтор через 7 дней)
  telegramPromptDismissedAt         DateTime?
  /// mamaGo Business: неверные попытки ввода SMS-кода в текущем «окне» (сбрасывается при новой отправке кода / успехе)
  businessContactOtpFailedAttempts  Int                              @default(0)
  /// Ступень escalation после серий по 3 неверных кода (0 = ещё не было блокировки; 1–3 = длительности; 4+ = support)
  businessContactOtpLockTier        Int                              @default(0)
  /// До какого момента действует блокировка проверки/повторной отправки (если не support)
  businessContactOtpLockedUntil     DateTime?
  /// Финальное ограничение: только поддержка support@mamago.by
  businessContactOtpSupportRequired Boolean                          @default(false)
  /// Подписка на маркетинговые письма (newsletters, promo campaigns, digests).
  /// System/transactional emails (verify, reset, critical notifications) не зависят от этого флага.
  marketingEmailsEnabled            Boolean                          @default(true)
  activities                        Activity[]                       @relation("ActivityOwner")
  performedAudits                   AuditLog[]                       @relation("AuditActor")
  performedAdminAuditLogs          AdminAuditLog[]                  @relation("AdminAuditActor")
  auditLogs                         AuditLog[]                       @relation("AuditTarget")
  business                          Business?
  businessInvitesSent               BusinessInvite[]                 @relation("BusinessInviteInviter")
  businessMemberships               BusinessMember[]
  bookingRequests                   BookingRequest[]
  bookingFeedbacks                  BookingFeedback[]
  reviewedBusinessVerifications     BusinessVerificationLog[]        @relation("ReviewedBy")
  children                          Child[]
  contentEdits                      ContentEditLog[]                 @relation("ContentEditor")
  ideas                             Idea[]
  assignedImprovementRequests       ImprovementRequest[]             @relation("ImprovementRequestAssignee")
  createdImprovementRequests        ImprovementRequest[]             @relation("ImprovementRequestCreator")
  uploadedMediaAssets               MediaAsset[]
  authoredArticles                  Article[]                        @relation("ArticleAuthor")
  createdEmailTemplateVersions      EmailTemplateVersion[]           @relation("EmailTemplateVersionCreatedBy")
  moderationLogs                    ModerationLog[]                  @relation("ModerationReviewer")
  notifications                     Notification[]
  notificationDeliveries            NotificationDelivery[]
  offerIdeas                        OfferIdea[]
  phoneOtps                         PhoneOtp[]
  archivedPlaces                    Place[]                          @relation("PlaceArchiver")
  createdPlaces                     Place[]                          @relation("PlaceCreator")
  moderatedPlaces                   Place[]                          @relation("PlaceModerator")
  reviewedPlaceClaimRequests        PlaceClaimRequest[]              @relation("ClaimReviewer")
  placeClaimRequests                PlaceClaimRequest[]              @relation("ClaimRequester")
  placeRevisions                    PlaceRevision[]                  @relation("PlaceRevisionReviewer")
  planItems                         PlanItem[]
  routes                            Route[]                          @relation("RouteAuthor")
  routeIdeas                        RouteIdea[]
  routeRatings                      RouteRating[]
  sessions                          Session[]
  tempMedia                         TempMedia[]
  telegramConnections               TelegramConnection[]
  telegramLinkTokens                TelegramLinkToken[]
  behaviorProfile                   UserBehaviorProfile?
  userEvents                        UserEvent[]
  performedModerationActions        UserModerationAction[]           @relation("ModeratorUser")
  moderationActions                 UserModerationAction[]           @relation("TargetUser")
  notificationPreferences           UserNotificationPreference[]
  unsubscribeTokens                 UnsubscribeToken[]               @relation("UnsubscribeTokens")
  createdBroadcasts                 AdminBroadcast[]                 @relation("AdminBroadcastCreator")
  devTelegramBusinessApplications   DevTelegramBusinessApplication[]
  searchQueryLogs                   SearchQueryLog[]
  createdPages                      Page[]                           @relation("PageCreatedBy")
  updatedPages                      Page[]                           @relation("PageUpdatedBy")

  @@index([email])
  @@index([resetToken])
  @@index([emailVerificationToken])
  @@index([phoneE164])
  @@index([status])
  @@index([lastLoginAt])
}

model UserBehaviorProfile {
  id                   String    @id @default(cuid())
  userId               String    @unique
  totalViews           Int       @default(0)
  totalOpens           Int       @default(0)
  totalSaves           Int       @default(0)
  totalPlanAdds        Int       @default(0)
  totalCtaClicks       Int       @default(0)
  firstSeenAt          DateTime?
  lastSeenAt           DateTime?
  weekendShare         Float     @default(0)
  sameDayPlanningShare Float     @default(0)
  advancePlanningShare Float     @default(0)
  preferredFormats     Json?
  preferredCategories  Json?
  preferredSignals     Json?
  preferredVerticals   Json?
  updatedAt            DateTime  @updatedAt
  /// PLAN_ADD buckets: same_day, weekend, advance (внутренние агрегаты).
  planningBuckets      Json?
  /// Вычисляемые сегменты (SegmentResolverService), например NEW_USER, SAVER.
  segmentKeys          String[]  @default([])
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lastSeenAt])
}

model UserEvent {
  id               String               @id @default(cuid())
  userId           String?
  sessionId        String?
  eventType        UserEventType
  entityType       AnalyticsEntityType?
  entityId         String?
  vertical         AnalyticsVertical?
  cityId           String?
  meta             Json?
  createdAt        DateTime             @default(now())
  promotionActions PromotionAction[]
  user             User?                @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([sessionId, createdAt])
  @@index([eventType, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([vertical, createdAt])
  @@index([cityId, createdAt])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
}

model PhoneOtp {
  id         String   @id @default(cuid())
  userId     String
  phoneE164  String
  purpose    String
  codeHash   String
  expiresAt  DateTime
  lastSentAt DateTime
  attempts   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, phoneE164, purpose])
  @@index([userId, purpose])
  @@index([phoneE164, purpose])
}

model TelegramLinkToken {
  id          String              @id @default(cuid())
  token       String              @unique
  userId      String
  environment TelegramEnvironment
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, environment, expiresAt])
  @@index([expiresAt])
}

model TelegramConnection {
  id                String              @id @default(cuid())
  userId            String
  environment       TelegramEnvironment
  botUsername       String
  telegramUserId    String
  telegramChatId    String
  telegramUsername  String?
  telegramFirstName String?
  isActive          Boolean             @default(true)
  linkedAt          DateTime            @default(now())
  lastInteractionAt DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, environment])
  @@unique([environment, telegramChatId])
  @@index([userId, isActive])
  @@index([environment, telegramUserId])
  @@index([environment, isActive])
}

model Child {
  id              String                @id @default(cuid())
  name            String
  birthDate       DateTime?
  interests       String?
  parentId        String
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  parent          User                  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  customInterests ChildCustomInterest[]
  systemInterests ChildInterest[]

  @@index([parentId])
}

model ChildInterest {
  id           String   @id @default(cuid())
  childId      String
  interestSlug String
  source       String   @default("SYSTEM")
  createdAt    DateTime @default(now())
  child        Child    @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([childId, interestSlug])
  @@index([childId])
  @@index([interestSlug])
}

model ChildCustomInterest {
  id             String   @id @default(cuid())
  childId        String
  label          String
  normalizedSlug String?
  status         String   @default("RAW")
  createdAt      DateTime @default(now())
  child          Child    @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId])
  @@index([normalizedSlug])
}

model Idea {
  id         String   @id @default(cuid())
  userId     String
  activityId String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, activityId])
  @@index([userId])
}

model PlanItem {
  id            String    @id @default(cuid())
  userId        String
  activityId    String?
  date          String
  startsAt      DateTime?
  createdAt     DateTime  @default(now())
  title         String?
  coverImageUrl String?
  /// Маршрут в плане (альтернатива событию)
  routeId       String?
  /// Slug для демо/внешнего маршрута, когда записи в Route нет (routeId = null)
  planRouteSlug String?
  activity      Activity? @relation(fields: [activityId], references: [id])
  route         Route?    @relation(fields: [routeId], references: [id])
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId])
  @@index([activityId])
  @@index([routeId])
  @@index([userId, planRouteSlug])
}

/// Сохранённые маршруты в «Идеи» (отдельно от Idea с activityId)
model RouteIdea {
  id        String   @id @default(cuid())
  userId    String
  routeId   String
  createdAt DateTime @default(now())
  route     Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, routeId])
  @@index([userId])
}

model SignalDefinition {
  id           String             @id @default(cuid())
  slug         String             @unique
  title        String
  order        Int                @default(0)
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  titleEn      String             @default("")
  icon         String?
  isFeatured   Boolean            @default(false)
  /// Два уровня: только корень (parentId = null) может иметь детей.
  parentId     String?
  /// True = seeded by system, cannot be deleted, key (slug) is immutable
  isSystem     Boolean            @default(false)
  /// Домен применения сигнала
  domain       SignalDomain?
  /// Типы сущностей, к которым применяется сигнал
  entityTypes  SignalEntityType[]
  /// Статус сигнала (активный или устаревший)
  status       SignalStatus       @default(ACTIVE)
  /// ID сигнала, который заменяет текущий (для устаревших сигналов)
  replacedById String?
  parent       SignalDefinition?  @relation("SignalDefinitionHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children     SignalDefinition[] @relation("SignalDefinitionHierarchy")
  /// Сигнал, который заменяет текущий
  replacedBy   SignalDefinition?  @relation("SignalReplacement", fields: [replacedById], references: [id])
  /// Сигналы, которые заменяет текущий
  replaces     SignalDefinition[] @relation("SignalReplacement")
  options      SignalOption[]

  @@index([order])
  @@index([parentId, order])
  @@index([domain])
  @@index([status])
}

model SignalOption {
  id           String           @id @default(cuid())
  definitionId String
  label        String
  value        String
  order        Int              @default(0)
  isActive     Boolean          @default(true)
  definition   SignalDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([definitionId, value])
  @@index([definitionId, isActive, order])
}

model FilterDefinition {
  id         String         @id @default(cuid())
  slug       String         @unique
  title      String
  type       String
  ui         String
  order      Int            @default(0)
  isActive   Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  orderIndex Int            @default(0)
  placement  UiPlacement    @default(PRIMARY)
  /// True = seeded by system, cannot be deleted, slug is immutable
  isSystem   Boolean        @default(false)
  /// Whether the public modal renders the group title above the control
  showTitle  Boolean        @default(true)
  options    FilterOption[]
  placements DiscoveryFilterPlacement[]
}

model FilterOption {
  id                    String                 @id @default(cuid())
  filterId              String
  label                 String
  value                 String
  order                 Int                    @default(0)
  isActive              Boolean                @default(true)
  orderIndex            Int                    @default(0)
  activityFilterOptions ActivityFilterOption[]
  filter                FilterDefinition       @relation(fields: [filterId], references: [id], onDelete: Cascade)

  @@unique([filterId, value])
  @@index([filterId, isActive, order])
}

model DiscoveryTaxonomyEntry {
  id         String                @id @default(cuid())
  axis       DiscoveryTaxonomyAxis
  slug       String
  title      String
  sortOrder  Int                   @default(0)
  isActive   Boolean               @default(true)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  /// Soft-archive: set instead of hard delete
  archivedAt DateTime?

  @@unique([axis, slug])
  @@index([axis, sortOrder])
}

model DiscoveryClassChip {
  id               String   @id @default(cuid())
  title            String
  slug             String   @unique
  description      String?
  icon             String?
  sortOrder        Int      @default(0)
  isActive         Boolean  @default(true)
  isDefault        Boolean  @default(false)
  isSystem         Boolean  @default(false)
  entityType       String   @default("OFFER")
  surfaceKey       String   @default("CLASSES")
  signalDefinitionId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([surfaceKey, isActive, sortOrder])
  @@index([signalDefinitionId])
}

model Occasion {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  type        OccasionType
  isActive    Boolean      @default(true)
  sortOrder   Int          @default(0)
  /// Начало периода актуальности (null = без периода, справочный повод)
  startsAt    DateTime?
  /// Конец периода актуальности (null = без периода)
  endsAt      DateTime?
  /// Сила влияния на ранжирование (0 = нейтральный сигнал)
  boostScore  Int          @default(0)
  /// Показывать ли редактору как актуальную подсказку в wizard
  autoSuggest Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  activityLinks ActivityOccasion[]

  @@index([sortOrder])
  @@index([type, sortOrder])
  @@index([isActive, startsAt, endsAt])
}

/// Join table: many-to-many Activity ↔ Occasion
model ActivityOccasion {
  activityId String
  occasionId String
  createdAt  DateTime @default(now())

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  occasion Occasion @relation(fields: [occasionId], references: [id], onDelete: Cascade)

  @@id([activityId, occasionId])
  @@index([occasionId])
  @@index([activityId])
}

/// Категории событий — отдельный справочник админки «Фильтры» (не SignalDefinition / не ranking).
model EventCategory {
  id                   String                       @id @default(cuid())
  nameRu               String
  nameEn               String
  slug                 String
  icon                 String?
  sortOrder            Int                          @default(0)
  isActive             Boolean                      @default(true)
  isFeatured           Boolean                      @default(false)
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  /// Родительская категория: только корень (parentId = null) может иметь детей; максимум 2 уровня.
  parentId             String?
  /// Soft-archive: set instead of hard delete
  archivedAt           DateTime?
  /// Сегментация категорий по типу контента (единый справочник, разные табы в админке).
  publicationType      EventCategoryPublicationType @default(EVENT)
  /// Если true → эту категорию можно выбирать внутри «программы» другого события.
  selectableInProgram  Boolean                      @default(false)
  /// Если true → при выборе этой категории как основной у события показываем блок «Что будет в программе».
  supportsProgram      Boolean                      @default(false)
  activities           Activity[]
  activityProgramLinks ActivityProgramCategory[]
  parent               EventCategory?               @relation("EventCategoryChildren", fields: [parentId], references: [id], onDelete: Restrict)
  children             EventCategory[]              @relation("EventCategoryChildren")
  genres               Genre[]
  placePrimary         Place[]                      @relation("PlacePrimaryCategory")
  placeSubcategories   PlaceSubcategory[]           @relation("PlaceSubcategoryCategory")
  filterPlacements     DiscoveryFilterPlacement[]

  @@unique([publicationType, slug])
  @@index([sortOrder])
  @@index([isActive, sortOrder])
  @@index([parentId])
  @@index([parentId, sortOrder])
  @@index([publicationType])
  @@index([publicationType, sortOrder])
}

/// Жанры контента, привязанные к корневой категории события.
/// Уникальность slug — в рамках category (одинаковые slug в разных категориях разрешены).
/// Дубли name/slug внутри одной категории блокируются в API (и name — дубли по названию).
model Genre {
  id         String        @id @default(cuid())
  name       String
  slug       String
  categoryId String
  sortOrder  Int           @default(0)
  isActive   Boolean       @default(true)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  category   EventCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, slug])
  @@index([categoryId, sortOrder])
  @@index([categoryId, isActive, sortOrder])
}

model City {
  id                    String            @id @default(cuid())
  name                  String
  slug                  String            @unique
  isActive              Boolean           @default(true)
  isVisibleInCityFilter Boolean           @default(true)
  priority              Int               @default(0)
  lat                   Float?
  lng                   Float?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  centerLat             Float?
  centerLng             Float?
  googleName            String?
  googleNames           Json?
  hasMetro              Boolean           @default(false)
  metroMaxDistanceM     Int?
  radiusKm              Float?
  districts             District[]
  importSources         ImportSource[]    @relation("ImportSourceCity")
  metroStations         MetroStation[]
  places                Place[]           @relation("PlaceCity")
  placeRevisions        PlaceRevision[]   @relation("PlaceRevisionCity")
  routes                Route[]
  searchQuickTags       SearchQuickTag[]
  searchQueryLogs       SearchQueryLog[]

  @@index([slug])
  @@index([isActive, isVisibleInCityFilter, priority])
  @@index([googleName])
}

model District {
  id                 String   @id @default(cuid())
  cityId             String
  name               String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  centerLat          Float?
  centerLng          Float?
  city               City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  placesAutoAssigned Place[]  @relation("PlaceDistrictAuto")
  placesManualPicked Place[]  @relation("PlaceDistrictManual")

  @@unique([cityId, name])
  @@index([cityId])
}

model MetroStation {
  id                 String     @id @default(cuid())
  cityId             String
  name               String
  lat                Float
  lng                Float
  osmType            String
  osmId              String
  source             String     @default("OSM")
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  activities         Activity[]
  city               City       @relation(fields: [cityId], references: [id], onDelete: Cascade)
  placesAutoAssigned Place[]    @relation("PlaceMetroAuto")
  placesManualPicked Place[]    @relation("PlaceMetroManual")

  @@unique([cityId, osmType, osmId])
  @@unique([cityId, name])
  @@index([cityId])
}

model Activity {
  id                   String                    @id @default(cuid())
  description          String?
  cityId               String?
  metroStationId       String?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  ageMaxMonths         Int?
  ageMinMonths         Int?
  ageLabel             String?
  businessId           String?
  coverImageUrl        String?
  createdBy            String?
  currency             String?                   @default("BYN")
  priceFrom            Float?
  ageTags              String[]
  coverImageId         String?
  nextOccurrenceAt     DateTime?
  ownerUserId          String
  placeId              String?
  priceText            String?
  priceTo              Float?
  scheduleJson         Json?
  scheduleMode         ScheduleMode
  shortDesc            String
  status               ContentStatus             @default(DRAFT)
  title                String
  type                 ActivityType
  format               ActivityFormat            @default(OFFLINE)
  priceDetails         String?
  /// Справочник «Фильтры → Категории событий» (опционально)
  eventCategoryId      String?
  /// Жанры события (slug из Genre, максимум 3, привязаны к eventCategoryId)
  genreSlugs           String[]                  @default([])
  seoCanonicalUrl      String?
  seoDescription       String?
  seoH1                String?
  seoJsonLdOverride    Json?
  seoOgDescription     String?
  seoOgImage           String?
  seoOgTitle           String?
  seoRobots            String?
  seoTitle             String?
  slug                 String?                   @unique
  slugUpdatedAt        DateTime?
  seoCanonicalSource   SeoCanonicalSource        @default(FALLBACK)
  business             Business?                 @relation("ActivityBusiness", fields: [businessId], references: [id])
  eventCategory        EventCategory?            @relation(fields: [eventCategoryId], references: [id])
  metroStation         MetroStation?             @relation(fields: [metroStationId], references: [id])
  organizerId          String?
  owner                User                      @relation("ActivityOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  organizer            Organizer?                @relation(fields: [organizerId], references: [id], onDelete: SetNull)
  place                Place?                    @relation("PlaceActivities", fields: [placeId], references: [id], onDelete: Restrict)
  coverImage           MediaAsset?               @relation("ActivityCover", fields: [coverImageId], references: [id])
  filterOptions        ActivityFilterOption[]
  images               ActivityImage[]
  programCategoryLinks ActivityProgramCategory[]
  sessions             ActivitySession[]
  slugHistory          ActivitySlugHistory[]
  venue                EventVenue?
  importedRecords      ImportedRecord[]          @relation("ImportedRecordActivity")
  planItems            PlanItem[]
  occasionLinks        ActivityOccasion[]
  /// Сигналы DISCOVERY домена (entityType=EVENT или OFFER), ID SignalDefinition
  discoverySignalIds   String[]                  @default([])

  priceItems             Json?

  // Настройки записи
  bookingEnabled         Boolean          @default(false)
  bookingMode            BookingMode?
  bookingPhone           String?
  bookingNote            String?
  bookingCapacityPerSlot Int?
