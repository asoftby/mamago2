  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  business                Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan                    Plan?                    @relation(fields: [planId], references: [id])
  commercialNotifications CommercialNotification[]

  @@index([businessId])
  @@index([status])
  @@index([endsAt])
  @@index([businessId, status])
}

model BusinessServicePlacement {
  id                      String                   @id @default(cuid())
  businessId              String
  entityType              ServiceEntityType
  entityId                String?
  status                  PlacementStatus          @default(ACTIVE)
  startsAt                DateTime
  endsAt                  DateTime
  notes                   String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  business                Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  commercialNotifications CommercialNotification[]

  @@index([businessId])
  @@index([entityType, entityId])
  @@index([endsAt])
  @@index([status])
  @@index([businessId, status])
}

model CommercialNotification {
  id                        String                       @id @default(cuid())
  businessId                String
  type                      CommercialNotificationType
  status                    CommercialNotificationStatus @default(PENDING)
  title                     String
  message                   String
  relatedContractId         String?
  relatedPlacementId        String?
  relatedServicePlacementId String?
  scheduledFor              DateTime
  sentAt                    DateTime?
  readAt                    DateTime?
  dismissedAt               DateTime?
  createdAt                 DateTime                     @default(now())
  business                  Business                     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  relatedContract           BusinessContract?            @relation(fields: [relatedContractId], references: [id])
  relatedPlacement          BusinessPlacement?           @relation(fields: [relatedPlacementId], references: [id])
  relatedServicePlacement   BusinessServicePlacement?    @relation(fields: [relatedServicePlacementId], references: [id])

  @@index([businessId])
  @@index([type])
  @@index([scheduledFor])
  @@index([status])
  @@index([businessId, status])
}

model MediaAsset {
  id               String           @id @default(cuid())
  kind             MediaAssetKind
  status           MediaAssetStatus @default(ACTIVE)
  filename         String
  originalName     String
  mimeType         String
  extension        String
  sizeBytes        Int
  width            Int?
  height           Int?
  durationSec      Float?
  storageKey       String           @unique
  publicUrl        String?
  checksum         String?
  alt              String?
  title            String?
  caption          String?
  sourceType       MediaSourceType
  uploadedById     String?
  /// Wizard session ID for TEMP media (null for committed media)
  wizardSessionId  String?
  /// Draft entity ID for TEMP media (activityId or placeId)
  draftEntityId    String?
  /// Draft entity type for TEMP media
  draftEntityType  String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
